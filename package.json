{
  "name": "ermaozi",
  "version": "0.2.0-beta.9",
  "description": "The ermaozi Astro theme for blogs and documentation sites.",
  "private": true,
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "documentation",
    "static-site-generator"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ermaozi/astro-theme-ermaozi.git"
  },
  "homepage": "https://astro.ermao.net",
  "bugs": {
    "url": "https://github.com/ermaozi/astro-theme-ermaozi/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node theme/scripts/auto-frontmatter.mjs && astro dev --host 127.0.0.1",
    "dev:fast": "node theme/scripts/auto-frontmatter.mjs && astro dev --host 127.0.0.1",
    "check": "node theme/scripts/auto-frontmatter.mjs && astro check && tsc -p theme/tsconfig.check-js.json",
    "check:js": "tsc -p theme/tsconfig.check-js.json",
    "build": "node theme/scripts/auto-frontmatter.mjs && astro check && tsc -p theme/tsconfig.check-js.json && astro build && pagefind --site dist --silent",
    "deploy": "node theme/scripts/auto-frontmatter.mjs && astro check && tsc -p theme/tsconfig.check-js.json && astro build && pagefind --site dist --silent",
    "preview": "astro preview --host 127.0.0.1",
    "audit": "node theme/scripts/audit.mjs",
    "test": "node --test internal/tests/*.test.mjs",
    "test:create": "tsc -p internal/create/tsconfig.json && node --test internal/create/tests/*.test.mjs",
    "test:visual": "playwright test --config internal/playwright.config.ts",
    "validate": "node theme/scripts/auto-frontmatter.mjs && astro check && tsc -p theme/tsconfig.check-js.json && astro build && pagefind --site dist --silent && node --test internal/tests/*.test.mjs && tsc -p internal/create/tsconfig.json && node --test internal/create/tests/*.test.mjs && node theme/scripts/audit.mjs"
  },
  "dependencies": {
    "@astrojs/vue": "7.0.1",
    "@docsearch/css": "4.6.3",
    "@docsearch/js": "4.6.3",
    "@iconify-json/simple-icons": "1.2.93",
    "@iconify-json/vscode-icons": "1.2.68",
    "@mathjax/src": "4.1.2",
    "@mdit-vue/plugin-toc": "3.0.2",
    "@mdit/plugin-alert": "1.0.1",
    "@mdit/plugin-attrs": "0.24.2",
    "@mdit/plugin-figure": "1.0.0",
    "@mdit/plugin-footnote": "0.22.2",
    "@mdit/plugin-img-lazyload": "1.0.0",
    "@mdit/plugin-img-mark": "1.0.0",
    "@mdit/plugin-img-size": "1.0.0",
    "@mdit/plugin-katex-slim": "1.0.1",
    "@mdit/plugin-mark": "0.22.2",
    "@mdit/plugin-mathjax-slim": "1.0.1",
    "@mdit/plugin-plantuml": "1.0.1",
    "@mdit/plugin-sub": "1.0.1",
    "@mdit/plugin-sup": "1.0.1",
    "@mdit/plugin-tasklist": "0.22.3",
    "@shikijs/colorized-brackets": "4.2.0",
    "@shikijs/transformers": "4.2.0",
    "@shikijs/twoslash": "4.2.0",
    "@vue/compiler-sfc": "3.5.29",
    "@waline/client": "3.13.0",
    "artalk": "2.9.1",
    "artplayer": "5.4.0",
    "astro": "7.1.6",
    "chart.js": "4.5.1",
    "dashjs": "5.2.0",
    "echarts": "6.1.0",
    "esbuild": "0.28.1",
    "flowchart.ts": "3.0.1",
    "giscus": "1.6.0",
    "github-slugger": "2.0.0",
    "gsap": "3.15.0",
    "hls.js": "1.6.16",
    "image-size": "2.0.2",
    "katex": "0.17.0",
    "markdown-it": "14.3.0",
    "markdown-it-anchor": "9.2.0",
    "markdown-it-cjk-friendly": "2.0.2",
    "markdown-it-container": "4.0.0",
    "markdown-it-emoji": "3.0.0",
    "marked": "14.1.4",
    "markmap-common": "0.18.9",
    "markmap-lib": "0.18.12",
    "markmap-toolbar": "0.18.12",
    "markmap-view": "0.18.12",
    "mermaid": "11.16.1",
    "mpegts.js": "1.7.3",
    "ogl": "1.0.11",
    "pagefind": "1.4.0",
    "photoswipe": "5.4.4",
    "postprocessing": "6.39.2",
    "qrcode": "1.5.4",
    "shiki": "4.2.0",
    "swiper": "14.0.1",
    "three": "0.185.0",
    "twikoo": "1.7.2",
    "vue": "3.5.29",
    "watermark-js-plus": "1.6.4",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@clack/prompts": "1.7.0",
    "@playwright/test": "1.55.1",
    "@types/markdown-it": "14.1.2",
    "@types/markdown-it-emoji": "3.0.1",
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "@types/three": "0.185.0",
    "less": "4.8.1",
    "sass": "1.102.0",
    "stylus": "0.64.0",
    "typescript": "5.9.3"
  }
}
