      document.addEventListener('theme-change', () => document.querySelectorAll<HTMLIFrameElement>('[data-demo] .draw-iframe').forEach(frame => {
        if (frame.contentDocument) frame.contentDocument.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'
      }))

      const decodeChartConfig = (value = '') => JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(value), character => character.charCodeAt(0))))
      const decodeChartSource = (value = '') => new TextDecoder().decode(Uint8Array.from(atob(value), character => character.charCodeAt(0)))
      const chartJsConfig = (element: HTMLElement) => element.dataset.chartType === 'js'
        ? Function(`let config,__chart_js_config__;{${decodeChartSource(element.dataset.chartConfig)};__chart_js_config__=config;}return __chart_js_config__;`)()
        : decodeChartConfig(element.dataset.chartConfig)
      const AsyncFunction = (async () => {}).constructor as FunctionConstructor
      const eChartsConfig = async (element: HTMLElement, echarts: unknown, chart: unknown) => element.dataset.chartType === 'js'
        ? AsyncFunction('echarts', 'myChart', `let width,height,option,__echarts_config__;{${decodeChartSource(element.dataset.chartConfig)};__echarts_config__={width,height,option};}return __echarts_config__;`)(echarts, chart)
        : { option: decodeChartConfig(element.dataset.chartConfig) }
      const loadCharts = async (root: ParentNode = document, refreshChartJs = false) => {
        const chartJs = [...root.querySelectorAll<HTMLElement>('[data-chartjs]')].filter(element => refreshChartJs || !element.dataset.chartReady)
        const eCharts = [...root.querySelectorAll<HTMLElement>('[data-echarts]:not([data-chart-ready])')]
        await Promise.all([
          chartJs.length && import('chart.js/auto').then(({ default: Chart }) => {
            Chart.defaults.borderColor = document.documentElement.dataset.theme === 'dark' ? '#ccc' : '#36a2eb'
            Chart.defaults.color = document.documentElement.dataset.theme === 'dark' ? '#fff' : '#000'
            Chart.defaults.maintainAspectRatio = false
            chartJs.forEach(element => {
              const canvas = element.querySelector<HTMLCanvasElement>('canvas')
              if (!canvas) return
              ;(element as any).__chart?.destroy()
              try {
                ;(element as any).__chart = new Chart(canvas, chartJsConfig(element))
                element.dataset.chartReady = 'true'
                element.style.display = 'block'
                element.previousElementSibling?.matches('.chartjs-loading') && element.previousElementSibling?.remove()
              } catch (error) { console.error('chartjs error:', error) }
            })
          }),
          eCharts.length && import('echarts').then(async echarts => {
            const globalConfig = useEChartsConfig()
            if (!globalConfig.isSetup) {
              await globalConfig.setup?.()
