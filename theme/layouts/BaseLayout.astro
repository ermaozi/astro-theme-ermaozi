      const repoElement = (tag: string, className = '', text?: string) => {
        const element = document.createElement(tag)
        if (className) element.className = className
        if (text !== undefined) element.textContent = text
        return element
      }
      const repoCount = (value: number) => value < 1000 ? String(value) : `${(value / 1000).toFixed(1)}k`
      const renderRepoCard = (card: HTMLElement, data: Record<string, any>) => {
        if (!data?.name) return
        const provider = card.dataset.provider === 'gitee' ? 'gitee' : 'github'
        const fullname = card.dataset.fullname === 'true' || (card.dataset.fullname === undefined && data.ownerType === 'Organization')
        const name = repoElement('p', 'repo-name')
        name.append(repoElement('span', `vpi-${provider}-repo`))
        const linkWrap = repoElement('span', 'repo-link')
        const link = repoElement('a', 'no-icon', fullname ? data.fullName : data.name) as HTMLAnchorElement
        link.href = data.url
        link.target = '_blank'
        link.rel = 'noopener noreferrer'
        link.title = data.fullName
        linkWrap.append(link)
        const visibility = repoElement('span', `repo-visibility${data.archived ? ' archived' : ''}`, `${data.visibility}${data.template ? ' Template' : ''}${data.archived ? ' archive' : ''}`)
        name.append(linkWrap, visibility)
        const description = repoElement('p', 'repo-desc', data.description ?? '')
        description.title = data.description ?? ''
        const info = repoElement('div', 'repo-info')
        if (data.language) {
          const language = repoElement('p')
          const dot = repoElement('span', 'repo-language')
          dot.style.backgroundColor = data.languageColor ?? ''
          language.append(dot, repoElement('span', '', data.language))
          info.append(language)
        }
        for (const [kind, value, title] of [
          ['star', data.convertStars ?? repoCount(Number(data.stars ?? 0)), `Stars: ${data.stars ?? 0}`],
          ['fork', data.convertForks ?? repoCount(Number(data.forks ?? 0)), `Forks: ${data.forks ?? 0}`],
        ]) {
          const item = repoElement('p')
          item.title = String(title)
          item.append(repoElement('span', `vpi-github-${kind}`), repoElement('span', '', String(value)))
          info.append(item)
        }
        if (data.license?.name) {
          const license = repoElement('p')
          license.title = `License: ${data.license.name}`
          license.append(repoElement('span', 'vpi-github-license'), repoElement('span', '', data.license.name))
          info.append(license)
        }
        card.replaceChildren(name, description, info)
        card.hidden = false
      }
      const loadRepoCards = async (root: ParentNode = document) => {
        const cards = [...root.querySelectorAll<HTMLElement>('[data-repo-card]:not([data-loaded])')]
        if (!cards.length) return
        let cache: Record<string, { info: Record<string, any>, updatedAt: number }> = {}
        try { cache = JSON.parse(localStorage.getItem('__VUEPRESS_GITHUB_REPO__') ?? '{}') } catch {}
        await Promise.all(cards.map(async card => {
          card.dataset.loaded = 'true'
          const [owner = '', name = ''] = (card.dataset.repo ?? '').split('/')
          if (!owner || !name) return
          const provider = card.dataset.provider === 'gitee' ? 'gitee' : 'github'
          const key = `${provider === 'github' ? '' : `${provider}:`}${owner}/${name}`
          let info = cache[key]?.info
          if (!info?.name || Date.now() - cache[key].updatedAt > 86_400_000) {
            try {
              const response = await fetch(`https://api.pengzhanbo.cn/${provider}/repo/${encodeURIComponent(owner)}/${encodeURIComponent(name)}`)
              if (!response.ok) throw new Error(`HTTP ${response.status}`)
              info = await response.json()
              info.convertStars = repoCount(Number(info.stars ?? 0))
              info.convertForks = repoCount(Number(info.forks ?? 0))
              cache[key] = { info, updatedAt: Date.now() }
              try { localStorage.setItem('__VUEPRESS_GITHUB_REPO__', JSON.stringify(cache)) } catch {}
            } catch (error) {
              console.error('github repo error:', error)
              return
            }
          }
          renderRepoCard(card, info)
        }))
      }
      void loadRepoCards()
