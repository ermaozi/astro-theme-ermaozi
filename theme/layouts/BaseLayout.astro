                const { option, ...size } = await eChartsConfig(element, echarts, chart)
                chart.resize(size)
                chart.setOption({ ...globalConfig.option, ...option })
                ;(element as any).__chart = chart
                element.dataset.chartReady = 'true'
                element.querySelector('.echarts-loading')?.remove()
              } catch (error) { console.error('echarts error:', error) }
            }))
          }),
        ])
      }
      void loadCharts()
