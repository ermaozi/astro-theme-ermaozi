      if (backToTop) {
        const percent = backToTop.querySelector<HTMLElement>('.percent')
        const circle = backToTop.querySelector<SVGCircleElement>('circle')
        let scrollTimer = 0
        const updateBackToTop = () => {
          const scrollable = Math.max(document.documentElement.scrollHeight - innerHeight, 0)
          const progress = scrollable ? Math.min(Math.round(scrollY / scrollable * 100), 100) : 0
          backToTop.hidden = !scrollable || scrollY <= innerHeight / 2
          percent?.classList.add('show')
          backToTop.querySelector('.icon')?.classList.remove('show')
          if (percent) percent.textContent = `${progress}%`
          if (circle) circle.style.strokeDasharray = `calc(${Math.PI * progress}% - ${4 * Math.PI}px) calc(${Math.PI * 100}% - ${4 * Math.PI}px)`
          clearTimeout(scrollTimer)
          scrollTimer = window.setTimeout(() => {
            percent?.classList.remove('show')
            backToTop.querySelector('.icon')?.classList.add('show')
          }, 1000)
        }
        addEventListener('scroll', updateBackToTop, { passive: true })
        addEventListener('resize', updateBackToTop, { passive: true })
