      const responsiveCount = (raw: string | undefined, defaults: { sm: number, md: number, lg: number }, mdBreakpoint: number) => {
        if (!raw) return innerWidth >= 960 ? defaults.lg : innerWidth >= mdBreakpoint ? defaults.md : defaults.sm
        try {
          const value = JSON.parse(raw)
          if (typeof value === 'number') return value
          return innerWidth >= 960 ? value.lg ?? defaults.lg : innerWidth >= mdBreakpoint ? value.md ?? defaults.md : value.sm ?? defaults.sm
        } catch {
          const value = Number(raw)
          return Number.isInteger(value) && value > 0 ? value : defaults.sm
        }
      }

      document.querySelectorAll<HTMLElement>('[data-dynamic-cards-app]:not([data-dynamic-cards-ready])').forEach(root => {
        try {
          const module = { exports: {} as { default?: object } }
          const source = new TextDecoder().decode(Uint8Array.from(atob(root.dataset.dynamicCardsCode ?? ''), character => character.charCodeAt(0)))
          Function('require', 'module', 'exports', source)((specifier: string) => {
            if (specifier === 'vue') return VueRuntime
            throw new Error(`Unsupported dynamic card dependency: ${specifier}`)
          }, module, module.exports)
          const app = VueRuntime.createApp(module.exports.default!)
          app.mount(root)
          root.dataset.dynamicCardsReady = 'true'
        } catch (error) {
