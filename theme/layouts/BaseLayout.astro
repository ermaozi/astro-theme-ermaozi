          collapsedLines.click()
        }
        const codeTreeFile = event.target instanceof Element ? event.target.closest<HTMLElement>('.vp-code-tree .vp-file-tree-info.file') : null
        if (codeTreeFile && (event.key === 'Enter' || event.key === ' ')) {
          event.preventDefault()
          selectCodeTreeFile(codeTreeFile)
        }
        const plot = event.target instanceof Element ? event.target.closest<HTMLElement>('.vp-plot.click') : null
        if (plot && (event.key === 'Enter' || event.key === ' ')) {
          event.preventDefault()
          plot.click()
