      const flowchartScale = () => innerWidth < 419 ? .8 : innerWidth > 1280 ? 1 : .9
      const loadFlowcharts = async (root: ParentNode = document) => {
        const elements = [...root.querySelectorAll<HTMLElement>('[data-flowchart]:not([data-flowchart-ready])')]
        if (!elements.length) return
        const { parse } = await import('flowchart.ts')
        elements.forEach(element => {
          try {
            const code = new TextDecoder().decode(Uint8Array.from(atob(element.dataset.flowCode ?? ''), character => character.charCodeAt(0)))
            const diagram = parse(code)
            const draw = () => {
              const scale = flowchartScale()
              diagram.draw(element.id, { ...flowchartPresets[element.dataset.flowPreset as keyof typeof flowchartPresets], scale })
              element.dataset.flowchartScale = String(scale)
            }
            draw()
            ;(element as any).__flowchart = { diagram, draw }
            element.dataset.flowchartReady = 'true'
            element.style.display = 'block'
            element.previousElementSibling?.matches('.flowchart-loading') && element.previousElementSibling?.remove()
          } catch (error) { console.error('flowchart error:', error) }
        })
      }
      void loadFlowcharts()
      document.addEventListener('plume-content-updated', event => {
        const target = event.target
        void loadFlowcharts(target instanceof Element || target instanceof DocumentFragment ? target : document)
      })
      let flowchartResize: number | undefined
      addEventListener('resize', () => {
        clearTimeout(flowchartResize)
        flowchartResize = window.setTimeout(() => document.querySelectorAll<HTMLElement>('[data-flowchart]').forEach(element => {
          if (element.dataset.flowchartScale !== String(flowchartScale())) (element as any).__flowchart?.draw()
        }), 100)
      }, { passive: true })

      const loadMarkmaps = async (root: ParentNode = document) => {
        const elements = [...root.querySelectorAll<HTMLElement>('[data-markmap]:not([data-markmap-ready])')]
        if (!elements.length) return
        const [{ Transformer }, view, { Toolbar }] = await Promise.all([
          import('markmap-lib'), import('markmap-view'), import('markmap-toolbar'),
        ])
        await Promise.all(elements.map(async element => {
          const svg = element.querySelector<SVGElement>('.markmap-svg')
          if (!svg) return
          try {
            const content = new TextDecoder().decode(Uint8Array.from(atob(element.dataset.markmapContent ?? ''), character => character.charCodeAt(0)))
            const transformer = new Transformer()
            const { frontmatter, features, root } = transformer.transform(content)
            const { styles, scripts } = transformer.getUsedAssets(features)
            await Promise.all([
              scripts ? view.loadJS(scripts, { getMarkmap: () => view }) : Promise.resolve(),
              styles ? view.loadCSS(styles) : Promise.resolve(),
            ])
            const markmap = view.Markmap.create(svg, view.deriveOptions({ maxWidth: 240, ...frontmatter?.markmap }))
            const toolbar = Toolbar.create(markmap).el
            await markmap.setData(root)
            await markmap.fit()
            toolbar.style.position = 'absolute'
            toolbar.style.right = '.5rem'
            toolbar.style.bottom = '.5rem'
            element.append(toolbar)
            ;(element as any).__markmap = markmap
            element.dataset.markmapReady = 'true'
            element.querySelector('.markmap-loading')?.remove()
          } catch (error) { console.error('markmap error:', error) }
        }))
      }
      void loadMarkmaps()
      document.addEventListener('plume-content-updated', event => {
        const target = event.target
        void loadMarkmaps(target instanceof Element || target instanceof DocumentFragment ? target : document)
      })
      let markmapResize: number | undefined
      addEventListener('resize', () => {
        clearTimeout(markmapResize)
        markmapResize = window.setTimeout(() => document.querySelectorAll<HTMLElement>('[data-markmap]').forEach(element => {
          void (element as any).__markmap?.fit()
        }), 100)
      }, { passive: true })

      const audioPlayers: HTMLAudioElement[] = []
      const loadAudioReaders = (root: ParentNode = document) => {
        root.querySelectorAll<HTMLElement>('[data-audio-reader]:not([data-audio-ready])').forEach(reader => {
          const audio = document.createElement('audio')
          const start = Number(reader.dataset.audioStart) || 0
          const end = Number(reader.dataset.audioEnd) || 0
          audio.className = 'audio-player'
          audio.hidden = true
          audio.preload = reader.dataset.audioAutoplay === 'true' ? 'auto' : 'none'
          audio.autoplay = reader.dataset.audioAutoplay === 'true'
          audio.src = reader.dataset.audioSrc ?? ''
          if (reader.dataset.audioVolume !== '') audio.volume = Math.min(1, Math.max(0, Number(reader.dataset.audioVolume)))
          const setPlaying = (playing: boolean) => {
            reader.classList.toggle('playing', playing)
            reader.setAttribute('aria-pressed', String(playing))
          }
          audio.addEventListener('canplay', () => { if (start) audio.currentTime = start })
          audio.addEventListener('play', () => setPlaying(true))
          audio.addEventListener('pause', () => setPlaying(false))
          audio.addEventListener('ended', () => setPlaying(false))
          audio.addEventListener('timeupdate', () => {
            if (end && audio.currentTime >= end) {
              audio.pause()
              if (start) audio.currentTime = start
            }
          })
          const toggle = () => {
            if (audio.paused) {
              audioPlayers.forEach(item => { if (item !== audio) item.pause() })
              void audio.play().catch(() => setPlaying(false))
            } else audio.pause()
          }
          reader.addEventListener('click', toggle)
          reader.addEventListener('keydown', event => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault()
              toggle()
            }
          })
          document.body.append(audio)
          audioPlayers.push(audio)
          ;(reader as any).__audio = audio
          reader.dataset.audioReady = 'true'
        })
      }
      loadAudioReaders()
      document.addEventListener('plume-content-updated', event => {
        const target = event.target
        loadAudioReaders(target instanceof Element || target instanceof DocumentFragment ? target : document)
      })

      const resizeEmbed = (element: HTMLElement, height: string | undefined, ratio: string | undefined) => {
        if (height) element.style.height = height
        else {
          const [width, ratioHeight] = (ratio || '16:9').split(':').map(Number)
          element.style.height = `${element.offsetWidth / (width / ratioHeight || 16 / 9)}px`
        }
      }
      const loadVideoEmbeds = (root: ParentNode = document) => {
        root.querySelectorAll<HTMLIFrameElement>('[data-video-embed]:not([data-video-ready])').forEach(frame => {
          const resize = () => resizeEmbed(frame, frame.dataset.videoHeight, frame.dataset.videoRatio)
          frame.addEventListener('load', resize)
          resize()
          frame.dataset.videoReady = 'true'
        })
      }
      const loadPdfViewers = (root: ParentNode = document) => {
        root.querySelectorAll<HTMLElement>('[data-pdf-viewer]:not([data-pdf-ready])').forEach(wrapper => {
          const url = new URL(wrapper.dataset.pdfSrc ?? '', location.href).toString()
          const userAgent = navigator.userAgent
          const mobile = /Android|iPad|iPhone|iPod|Mobile/i.test(userAgent) || (/Macintosh/i.test(userAgent) && navigator.maxTouchPoints > 1)
          const safari = !mobile && /Safari/i.test(userAgent) && !/(?:Chrome|Chromium|CriOS|Edg)/i.test(userAgent)
          const query = `#page=${wrapper.dataset.pdfPage}&toolbar=${wrapper.dataset.pdfToolbar}&zoom=${wrapper.dataset.pdfZoom}`
          const pdfjsUrl = new URL(wrapper.dataset.pdfjsUrl || 'https://static.pengzhanbo.cn/pdfjs/', location.href).toString().replace(/\/?$/, '/')
          const source = mobile ? `${pdfjsUrl}web/viewer.html?file=${url}${query}` : `${url}${query}`
          const viewer = document.createElement(mobile || safari ? 'iframe' : 'embed')
          viewer.className = 'pdf-viewer'
          viewer.setAttribute('type', 'application/pdf')
          viewer.setAttribute('title', wrapper.dataset.pdfTitle || 'PDF Viewer')
          viewer.setAttribute('src', source)
          if (viewer instanceof HTMLIFrameElement) viewer.allow = 'fullscreen'
          wrapper.replaceChildren(viewer)
          resizeEmbed(wrapper, wrapper.dataset.pdfHeight, wrapper.dataset.pdfRatio)
          wrapper.dataset.pdfReady = 'true'
        })
      }
      loadVideoEmbeds()
      loadPdfViewers()
      document.addEventListener('plume-content-updated', event => {
        const target = event.target
        const root = target instanceof Element || target instanceof DocumentFragment ? target : document
        loadVideoEmbeds(root)
        loadPdfViewers(root)
      })
      addEventListener('resize', () => {
        document.querySelectorAll<HTMLElement>('[data-video-embed]').forEach(element => resizeEmbed(element, element.dataset.videoHeight, element.dataset.videoRatio))
        document.querySelectorAll<HTMLElement>('[data-pdf-viewer]').forEach(element => resizeEmbed(element, element.dataset.pdfHeight, element.dataset.pdfRatio))
      }, { passive: true })

      const supportedVideoTypes = new Set(['mp4', 'mp3', 'webm', 'ogg', 'mpd', 'dash', 'm3u8', 'hls', 'ts', 'flv', 'mkv', 'mov', 'ogv'])
      const artPlayerCustomType = (type: string) => {
        const customType: Record<string, (video: HTMLVideoElement, url: string, art: any) => Promise<void>> = {}
        if (type === 'mpd' || type === 'dash') customType[type] = async (video, url, art) => {
          const { supportsMediaSource, MediaPlayer } = await import('dashjs')
          if (!supportsMediaSource()) return
          const player = MediaPlayer().create()
          player.initialize(video, url, art.option.autoplay, 0)
          art.on('destroy', () => player.destroy())
        }
        if (type === 'm3u8' || type === 'hls') customType[type] = async (video, url, art) => {
          if (video.canPlayType('application/x-mpegURL') || video.canPlayType('application/vnd.apple.mpegURL')) {
            video.src = url
            return
          }
          const Hls = (await import('hls.js')).default
          if (!Hls.isSupported()) return
          const hls = new Hls()
          hls.attachMedia(video)
          hls.on(Hls.Events.MEDIA_ATTACHED, () => hls.loadSource(url))
          art.on('destroy', () => hls.destroy())
        }
        if (type === 'ts' || type === 'flv') customType[type] = async (video, url, art) => {
          const mpegts = (await import('mpegts.js')).default
          if (!mpegts.isSupported()) return
          const player = mpegts.createPlayer({ type: 'flv', url })
          player.attachMediaElement(video)
          player.load()
          art.on('destroy', () => player.destroy())
        }
        return customType
      }
      const resizeArtPlayer = (wrapper: HTMLElement) => {
        const container = wrapper.querySelector<HTMLElement>('.vp-artplayer')
        if (!container) return
        if (wrapper.dataset.artplayerHeight) container.style.height = wrapper.dataset.artplayerHeight
        else {
          const [width, height] = (wrapper.dataset.artplayerRatio ?? '16:9').split(':').map(Number)
          container.style.height = `${container.offsetWidth / (width / height || 16 / 9)}px`
        }
      }
      const loadArtPlayers = async (root: ParentNode = document) => {
        const wrappers = [...root.querySelectorAll<HTMLElement>('[data-artplayer]:not([data-artplayer-ready])')]
        if (!wrappers.length) return
        const { default: ArtPlayer } = await import('artplayer')
        wrappers.forEach(wrapper => {
          wrapper.querySelector('.md-power-loading')?.remove()
          const container = wrapper.querySelector<HTMLElement>('.vp-artplayer')
          if (!container) return
          try {
            const options = decodeChartConfig(wrapper.dataset.artplayerOptions)
            if (!supportedVideoTypes.has(options.type)) throw new Error(`Unsupported video type: ${options.type}`)
            const { customType = {}, ...playerOptions } = options
            resizeArtPlayer(wrapper)
            ;(wrapper as any).__artplayer = new ArtPlayer({
              container,
              url: wrapper.dataset.artplayerSrc,
              lang: document.documentElement.lang.startsWith('zh') ? 'zh-cn' : 'en',
              useSSR: false,
              theme: getComputedStyle(document.documentElement).getPropertyValue('--vp-c-brand-1').trim() || '#5086a1',
              hotkey: true,
              mutex: true,
              playsInline: true,
              ...playerOptions,
              customType: { ...artPlayerCustomType(options.type), ...customType },
            })
            wrapper.dataset.artplayerReady = 'true'
          } catch (error) { console.error('artplayer error:', error) }
        })
      }
      void loadArtPlayers()
      document.addEventListener('plume-content-updated', event => {
        const target = event.target
        void loadArtPlayers(target instanceof Element || target instanceof DocumentFragment ? target : document)
      })
      addEventListener('resize', () => document.querySelectorAll<HTMLElement>('[data-artplayer]').forEach(resizeArtPlayer), { passive: true })

      const syncCanIUseTheme = () => {
        const dark = document.documentElement.dataset.theme === 'dark'
        document.querySelectorAll<HTMLElement>('[data-caniuse]').forEach(embed => {
          const feature = embed.dataset.feature ?? ''
          const meta = embed.dataset.meta ?? ''
          const baseline = embed.dataset.baseline === 'true'
          const hash = baseline
            ? `meta=${meta}&theme=${dark ? 'dark' : 'light'}`
            : `past=${embed.dataset.past}&future=${embed.dataset.future}&meta=${meta}&theme=${dark ? 'dark' : 'light'}`
          const frame = embed.querySelector<HTMLIFrameElement>('iframe')
          if (frame) frame.src = `https://caniuse.pengzhanbo.cn/${encodeURIComponent(feature)}${baseline ? '/baseline' : ''}#${hash}`
        })
      }
      syncCanIUseTheme()
      document.addEventListener('theme-change', syncCanIUseTheme)
      const syncCodeEmbedTheme = () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'
        document.querySelectorAll<HTMLIFrameElement>('[data-code-embed]:not([data-theme-locked])').forEach(frame => {
          const url = new URL(frame.src)
          if (frame.dataset.codeEmbed === 'codepen') url.searchParams.set('theme-id', theme)
          else if (frame.dataset.codeEmbed === 'replit') url.searchParams.set('theme', theme)
          else if (frame.dataset.codeEmbed === 'jsfiddle') {
            url.pathname = `/${frame.dataset.codeSource}/embedded/${frame.dataset.codeTab}${theme === 'dark' ? '/dark/' : ''}`
          }
          if (frame.src !== url.href) frame.src = url.href
        })
      }
      syncCodeEmbedTheme()
      document.addEventListener('theme-change', syncCodeEmbedTheme)
      addEventListener('message', event => {
        if (event.origin !== 'https://caniuse.pengzhanbo.cn') return
        let data = event.data
        if (typeof data === 'string') {
          try { data = JSON.parse(data) } catch { return }
        }
        if (data?.type !== 'ciu-embed' || !data.payload) return
        const embed = [...document.querySelectorAll<HTMLElement>('[data-caniuse]')].find(item => item.dataset.feature === data.payload.feature && item.dataset.meta === data.payload.meta)
        const height = Math.ceil(Number(data.payload.height))
        if (embed && Number.isFinite(height)) {
          const frame = embed.querySelector<HTMLIFrameElement>('iframe')
          if (frame) frame.style.height = `${height}px`
        }
      })

      const qrCodes = [...document.querySelectorAll<HTMLElement>('[data-qrcode]')]
      if (qrCodes.length) {
        const { toCanvas, toDataURL } = await import('qrcode')
        const loadQrLogo = (url: string) => new Promise<HTMLImageElement>((resolve, reject) => {
          const logo = new Image()
          logo.crossOrigin = 'anonymous'
          logo.onload = () => resolve(logo)
          logo.onerror = () => reject(new Error('Failed to load QR code logo'))
          logo.src = new URL(url, location.href).toString()
        })
        await Promise.all(qrCodes.map(async wrapper => {
          const raw = wrapper.dataset.qrcodeText ?? ''
          const text = raw === '.'
            ? location.href.split(/[?#]/)[0]
            : raw.startsWith('//')
              ? `${location.protocol}${raw}`
              : wrapper.dataset.qrcodeInternal === 'true'
                ? new URL(raw, location.href).toString()
                : raw
          if (!text) return
          const image = wrapper.querySelector<HTMLImageElement>('.qrcode-img')
          if (!image) return
          const level = wrapper.dataset.qrcodeLevel
          const version = Number(wrapper.dataset.qrcodeVersion)
          const maskPattern = Number(wrapper.dataset.qrcodeMask)
          const margin = Number(wrapper.dataset.qrcodeMargin)
          const scale = Number(wrapper.dataset.qrcodeScale)
          const internal = wrapper.dataset.qrcodeInternal === 'true'
          const logo = wrapper.dataset.qrcodeLogo || (internal ? document.querySelector<HTMLLinkElement>('link[rel="icon"]')?.href : '')
          const configuredLogoSize = Number.parseFloat(wrapper.dataset.qrcodeLogoSize || '0.2')
          const logoSize = Number.isFinite(configuredLogoSize) && configuredLogoSize > 0 ? configuredLogoSize : .2
          const pixelWidth = 300 * Math.max(Math.round(devicePixelRatio || 1), 1)
          const options: QRCodeToDataURLOptions = {
            width: pixelWidth,
            margin: Number.isFinite(margin) ? margin : 2,
            scale: Number.isFinite(scale) ? scale : 4,
            errorCorrectionLevel: level && ['L', 'M', 'Q', 'H'].includes(level.toUpperCase()) ? level.toUpperCase() as 'L' | 'M' | 'Q' | 'H' : logo ? 'H' : 'M',
            ...(version >= 1 && version <= 40 ? { version } : {}),
            ...(maskPattern >= 0 && maskPattern <= 7 && wrapper.dataset.qrcodeMask !== '' ? { maskPattern: maskPattern as QRCodeMaskPattern } : {}),
            color: {
              ...(wrapper.dataset.qrcodeDark ? { dark: wrapper.dataset.qrcodeDark } : {}),
              ...(wrapper.dataset.qrcodeLight ? { light: wrapper.dataset.qrcodeLight } : {}),
            },
          }
          const segments: QRCodeByteSegment[] = [{ data: new TextEncoder().encode(text), mode: 'byte' }]
          if (logo) {
            try {
              const [canvas, logoImage] = await Promise.all([toCanvas(segments, options), loadQrLogo(logo)])
              const context = canvas.getContext('2d')!
              const logoWidth = logoSize * canvas.width
              const logoHeight = logoWidth / logoImage.naturalWidth * logoImage.naturalHeight
              const x = (canvas.width - logoWidth) / 2
              const y = (canvas.height - logoHeight) / 2
              context.fillStyle = options.color?.light || '#fff'
              context.beginPath()
              context.roundRect(x, y, logoWidth, logoHeight, logoWidth / 20)
              context.fill()
              context.drawImage(logoImage, x, y, logoWidth, logoHeight)
              image.src = canvas.toDataURL('image/png')
            } catch {
              image.src = await toDataURL(segments, options)
            }
          } else image.src = await toDataURL(segments, options)
          image.width = pixelWidth
          image.height = pixelWidth
          image.alt = text
          image.title = text
          image.hidden = false
          const isLink = wrapper.dataset.qrcodeIsLink === 'true'
          const link = wrapper.querySelector<HTMLAnchorElement>('[data-qrcode-link]')
          const value = wrapper.querySelector<HTMLElement>('[data-qrcode-value]')
          if (link && isLink) {
            link.href = text
            link.textContent = text
            link.hidden = false
            if (value) value.hidden = true
          } else if (value) {
            value.replaceChildren(...text.split('\n').flatMap((line, index) => index ? [document.createElement('br'), document.createTextNode(line)] : [document.createTextNode(line)]))
          }
        }))
      }
    </script>
    <script>
      const diagrams = [...document.querySelectorAll<HTMLElement>('[data-mermaid-source]')]
      if (diagrams.length) {
        const { default: mermaid } = await import('mermaid')
        let renderIndex = 0
        const render = async () => {
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
          })
          for (const diagram of diagrams) {
            const source = new TextDecoder().decode(Uint8Array.from(atob(diagram.dataset.mermaidSource ?? ''), character => character.charCodeAt(0)))
            const content = diagram.querySelector<HTMLElement>('.mermaid-content')
            if (!content) continue
            const result = await mermaid.render(`${diagram.dataset.mermaidId}-${renderIndex++}`, source)
            content.innerHTML = result.svg
          }
        }
        await render()
        document.addEventListener('theme-change', () => { void render() })
      }
    </script>
  </body>
</html>
