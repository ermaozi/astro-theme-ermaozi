      document.querySelectorAll<HTMLElement>('[data-card-grid-cols]').forEach(grid => {
        const draw = () => {
          const count = responsiveCount(grid.dataset.cardGridCols, { sm: 1, md: 2, lg: 2 }, 768)
          grid.className = `vp-card-grid cols-${count}`
          grid.style.gridTemplateColumns = `repeat(${count}, 1fr)`
        }
        draw()
        addEventListener('resize', draw, { passive: true })
      })

      document.querySelectorAll<HTMLElement>('.vp-card-masonry').forEach((masonry, masonryIndex) => {
        const items = [...masonry.children]
        const gap = Number(masonry.dataset.masonryGap) || 16
        items.forEach((item, itemIndex) => item.classList.add(`masonry-v-${masonryIndex}-${itemIndex}`))
        const draw = () => {
          const count = responsiveCount(masonry.dataset.masonryCols, { sm: 2, md: 2, lg: 3 }, 640)
          const heights = Array.from({ length: count }, () => 0)
          const itemHeights = items.map(item => (item as HTMLElement).offsetHeight)
          const columns = Array.from({ length: count }, () => {
            const column = document.createElement('div')
            column.className = 'card-masonry-item'
            column.style.gap = `${gap}px`
            return column
          })
          masonry.replaceChildren(...columns)
          masonry.className = `vp-card-masonry cols-${count}`
          masonry.style.gap = `${gap}px`
          masonry.style.setProperty('--card-masonry-cols', String(count))
          items.forEach((item, index) => {
            const columnIndex = heights.indexOf(Math.min(...heights))
            columns[columnIndex].append(item)
            heights[columnIndex] += itemHeights[index] + gap
          })
        }
        draw()
        addEventListener('resize', draw, { passive: true })
        new ResizeObserver(draw).observe(masonry)
