        const treeButton = event.target.closest<HTMLButtonElement>('[data-copy-tree]')
        if (treeButton) {
          const tree = treeButton.closest<HTMLElement>('.vp-file-tree')
          if (!tree) return
          const renderNodes = (container: Element, prefix = ''): string => {
            const nodes = [...container.children].filter(child => child.classList.contains('vp-file-tree-node') && !child.classList.contains('generated'))
            return nodes.map((node, index) => {
              const name = node.querySelector<HTMLElement>(':scope > .vp-file-tree-info > .name')?.textContent?.trim() ?? ''
              const last = index === nodes.length - 1
              const group = node.querySelector<HTMLElement>(':scope > .group')
              return `${prefix}${last ? '└── ' : '├── '}${name}\n${group ? renderNodes(group, `${prefix}${last ? '    ' : '│   '}`) : ''}`
            }).join('')
