      const loadSwipers = async (root: ParentNode = document) => {
        const elements = [...root.querySelectorAll<HTMLElement>('[data-swiper-options]:not([data-swiper-ready])')]
        if (!elements.length) return
        const [{ default: Swiper }, modules] = await Promise.all([import('swiper'), import('swiper/modules')])
        const effects: Record<string, any> = {
          fade: modules.EffectFade,
          cube: modules.EffectCube,
          flip: modules.EffectFlip,
          coverflow: modules.EffectCoverflow,
          cards: modules.EffectCards,
          creative: modules.EffectCreative,
        }
        elements.forEach(element => {
          let options: any
          try { options = JSON.parse(element.dataset.swiperOptions ?? '{}') } catch { return }
          const mode = options.mode ?? 'banner'
          const enabledModules = mode === 'carousel'
            ? [modules.Autoplay]
            : mode === 'broadcast'
              ? [modules.Navigation, modules.Pagination, modules.Mousewheel]
              : [modules.Navigation, modules.Pagination, modules.Autoplay, effects[options.effect]].filter(Boolean)
          element.dataset.swiperReady = 'true'
          const swiper = new Swiper(element, {
            modules: enabledModules,
            autoplay: mode === 'banner'
              ? { delay: options.delay, disableOnInteraction: false, pauseOnMouseEnter: options.pauseOnMouseEnter }
              : mode === 'carousel' ? { delay: 0, disableOnInteraction: false } : false,
            navigation: options.navigation && mode !== 'carousel' ? {
              prevEl: element.querySelector<HTMLElement>('.swiper-button-prev'),
              nextEl: element.querySelector<HTMLElement>('.swiper-button-next'),
            } : false,
            pagination: mode !== 'carousel' ? { el: element.querySelector<HTMLElement>('.swiper-pagination'), dynamicBullets: true, clickable: true } : false,
            mousewheel: mode === 'broadcast' ? options.mousewheel : false,
            effect: mode === 'banner' ? options.effect : 'slide',
            creativeEffect: options.creativeEffect,
            speed: options.speed,
            loop: options.loop,
            slidesPerView: options.slidesPerView,
            spaceBetween: options.spaceBetween,
          })
          if (mode === 'carousel' && options.pauseOnMouseEnter) {
            element.addEventListener('mouseenter', () => swiper.autoplay.stop())
            element.addEventListener('mouseleave', () => swiper.autoplay.start())
          } else if (mode === 'carousel') {
            new MutationObserver(() => {
              swiper.wrapperEl.style.transform = 'translate3d(0px, 0px, 0px)'
              setTimeout(() => swiper.update(), 350)
            }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
          }
        })
      }
      void loadSwipers()
      document.addEventListener('plume-content-updated', event => {
        const target = event.target
        void loadSwipers(target instanceof Element || target instanceof DocumentFragment ? target : document)
      })

      const decodeDemoValue = (value = '') => new TextDecoder().decode(Uint8Array.from(atob(value), character => character.charCodeAt(0)))
      const loadDemos = (root: ParentNode = document) => {
        root.querySelectorAll<HTMLElement>('.vp-demo-wrapper:not([data-demo-controls-ready])').forEach(demo => {
          const button = demo.querySelector<HTMLButtonElement>('[aria-label="Toggle Code"]')
          const code = demo.querySelector<HTMLElement>('.demo-code')
          if (button && code) {
            button.addEventListener('click', () => {
              code.hidden = !code.hidden
              button.setAttribute('aria-expanded', String(!code.hidden))
            })
          }
          const resourcesButton = demo.querySelector<HTMLButtonElement>('.demo-resources-toggle')
          const resources = demo.querySelector<HTMLElement>('.demo-resources-container')
          if (resourcesButton && resources) {
            resourcesButton.addEventListener('click', () => {
              resources.hidden = !resources.hidden
              resourcesButton.setAttribute('aria-expanded', String(!resources.hidden))
            })
            document.addEventListener('click', event => {
              if (event.target instanceof Node && !resourcesButton.parentElement?.contains(event.target)) {
                resources.hidden = true
                resourcesButton.setAttribute('aria-expanded', 'false')
              }
            })
          }
          demo.dataset.demoControlsReady = 'true'
        })
        root.querySelectorAll<HTMLElement>('[data-demo]:not([data-demo-ready])').forEach(demo => {
          const frame = demo.querySelector<HTMLIFrameElement>('.draw-iframe')
          if (!frame) return
          const html = decodeDemoValue(demo.dataset.demoHtml)
          const css = decodeDemoValue(demo.dataset.demoCss)
          const cssLib = JSON.parse(decodeDemoValue(demo.dataset.demoCssLib) || '[]') as string[]
          const jsLib = JSON.parse(decodeDemoValue(demo.dataset.demoJsLib) || '[]') as string[]
          const scriptEnd = '<' + '/script>'
          const js = decodeDemoValue(demo.dataset.demoJs).replaceAll(scriptEnd, '<\\' + '/script>')
          const safeUrl = (value: string) => value.replaceAll('&', '&amp;').replaceAll('"', '&quot;').replaceAll('<', '&lt;')
          const stylesheets = cssLib.map(url => `<link rel="stylesheet" href="${safeUrl(url)}">`).join('')
          const scripts = jsLib.map(url => `<script src="${safeUrl(url)}">${scriptEnd}`).join('')
          const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'
          frame.srcdoc = `<!doctype html><html data-theme="${theme}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">${stylesheets}${scripts}<style>html,body{margin:0}body{padding:1px}${css}</style></head><body>${html}<script>;(function(){${js}})();${scriptEnd}</body></html>`
          frame.addEventListener('load', () => {
            const resize = () => { frame.style.height = `${Math.max(80, frame.contentDocument?.documentElement.scrollHeight ?? 0)}px` }
            resize()
            if (frame.contentDocument?.body) new ResizeObserver(resize).observe(frame.contentDocument.body)
            demo.dataset.demoReady = 'true'
          }, { once: true })
        })
        root.querySelectorAll<HTMLElement>('[data-vue-demo]:not([data-demo-ready])').forEach(demo => {
          const mount = demo.querySelector<HTMLElement>('[data-demo-vue-mount]')
