---
import type { ContentEntry, Lang } from '../lib/content'
import { absoluteUrl, authorsOf, imagesOf, iso, modifiedTimeOf, siteLocale, structuredPageData } from '../lib/seo'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import BackToTop from '../components/BackToTop.astro'
import Bulletin from '../components/Bulletin.astro'
import GlobalEncrypt from '../components/GlobalEncrypt.astro'
import SignDown from '../components/SignDown.astro'
import Watermark from '../components/Watermark.astro'
import UserSlot from '../components/UserSlot.astro'
import '../styles/global.css'
import 'swiper/css/bundle'
import 'photoswipe/dist/photoswipe.css'
import '../styles/plume-parity.css'
import 'katex/dist/katex.min.css'
import '../styles/custom.css'
import { siteConfig } from '../../site.config.mjs'
import { encryptContent } from '../lib/encryption'
import { globalAdminCredentials } from '../lib/encrypt-policy'
import { localeOf, rootLanguage } from '../lib/locales'
import { hasUserSlot } from '../lib/user-slots'
import { iconAssetUrls } from '../lib/iconify'
import { homeConfigOf } from '../lib/home'
import { twitterHandle } from '../lib/social'
import { withBase } from '../lib/client-utils'

interface Props {
  entry?: ContentEntry
  title: string
  description: string
  lang: Lang
  route: string
  translationRoute?: string
  languageLinks?: Array<{ lang: Lang, href: string, fallback?: boolean }>
  pageClass?: string
  noindex?: boolean
  article?: boolean
  minimal404?: boolean
  layout?: 'doc' | 'friends' | 'home' | 'page' | 'posts'
}

const { entry, title, description, lang, route, translationRoute, languageLinks = [], pageClass = '', noindex = false, article = false, minimal404 = false, layout = 'doc' } = Astro.props
const isHome = layout === 'home' || entry?.data.home === true || entry?.data.pageLayout === 'home'
const site = siteLocale(lang)
const generated = !entry && !minimal404
const fullTitle = minimal404 ? site.siteName : `${title} | ${site.siteName}`
const canonical = absoluteUrl(route)
const alternates = languageLinks.length ? languageLinks.filter(item => !item.fallback) : [{ lang, href: route }, ...(translationRoute ? [{ lang: lang === 'en-US' ? 'zh-CN' : 'en-US', href: translationRoute }] : [])]
const defaultRoute = alternates.find(item => item.lang === rootLanguage())?.href ?? route
const locale = localeOf(lang)
const seoEnabled = entry?.data.seo !== false
const jsonLd = minimal404
  ? [{ '@context': 'https://schema.org', '@type': 'WebPage', name: '', description }]
  : seoEnabled ? structuredPageData(title, description, lang, route, entry) : []
const seoOptions = ((siteConfig.plugins as Record<string, unknown>)?.seo ?? {}) as { fallBackImage?: string }
const socialCover = entry?.data.banner ?? entry?.data.cover
const imageSource = socialCover ?? imagesOf(entry)[0] ?? seoOptions.fallBackImage ?? siteConfig.logo
const image = imageSource.startsWith('/') ? absoluteUrl(imageSource) : imageSource
const seoTags = entry?.data.tags.length ? entry.data.tags : typeof entry?.data.tag === 'string' ? [entry.data.tag] : entry?.data.tag ?? []
const seoAuthors = authorsOf(entry?.data.author, site.authorName)
const published = entry ? iso(entry.data.date ?? entry.data.time) : undefined
const preconnectMedia = Boolean(siteConfig.mediaOrigin && image.startsWith(`${siteConfig.mediaOrigin}/`))
const modified = entry && !isHome ? modifiedTimeOf(entry) : undefined
const defaultKeywords = site.keywords
const head = entry?.data.head ?? []
const headItems = head.filter(Array.isArray) as unknown as Array<[string, Record<string, string>, string?]>
const customKeywords = headItems.find(([tag, attrs]) => tag === 'meta' && attrs.name === 'keywords')?.[1].content
type WatermarkPage = { path: string, title: string, lang: Lang, filePathRelative?: string, frontmatter: Record<string, unknown> }
type WatermarkConfig = boolean | {
  enabled?: boolean | ((page: WatermarkPage) => boolean)
  fullPage?: boolean
  options?: Record<string, unknown>
  watermarkOptions?: Record<string, unknown>
}
const watermarkConfig = (siteConfig.watermark ?? (siteConfig.plugins as { watermark?: WatermarkConfig }).watermark ?? false) as WatermarkConfig
const watermarkEnabled = typeof watermarkConfig === 'boolean'
  ? watermarkConfig
  : typeof watermarkConfig.enabled === 'function'
    ? watermarkConfig.enabled({ path: route, title, lang, filePathRelative: entry?.id, frontmatter: entry?.data ?? {} })
    : watermarkConfig.enabled !== false
const watermarkSetting = entry?.data.watermark ?? watermarkEnabled
const watermarkOptions = !watermarkSetting
  ? undefined
  : {
      ...(typeof watermarkConfig === 'object' ? (watermarkConfig.watermarkOptions ?? watermarkConfig.options) : {}),
      fullPage: typeof watermarkConfig === 'object' ? watermarkConfig.fullPage : true,
      ...(typeof watermarkSetting === 'object' ? watermarkSetting : {}),
    }
const keywords = customKeywords ?? defaultKeywords
const metaHead = headItems.filter(([tag, attrs]) => tag === 'meta' && !['description', 'keywords', 'robots'].includes(attrs.name ?? ''))
const linkHead = headItems.filter(([tag, attrs]) => tag === 'link' && !['canonical', 'alternate', 'icon', 'preconnect', 'dns-prefetch'].includes(attrs.rel ?? ''))
const scriptHead = headItems.filter(([tag]) => tag === 'script')
const homeConfig = isHome && entry ? homeConfigOf(entry.data) : []
const showSignDown = Boolean(entry && isHome
  && entry.data.signDown === true
  && (entry.data.config?.length ?? 0) > 1
  && entry.data.config?.[0]?.full === true)
const singleHomeSection = isHome && homeConfig.length === 1
const shortHomeConfig = isHome && entry?.data.config !== undefined && entry.data.config.length <= 1
const forcedHero = isHome
  ? homeConfig.find(item => item.type === 'hero' && item.forceDark === true)
  : undefined
const appearance = (locale.appearance ?? siteConfig.appearance ?? true) as boolean | 'dark' | 'force-dark'
const forceDark = Boolean(forcedHero) || appearance === 'force-dark'
const forcedEffectValue = forcedHero?.effect ?? forcedHero?.background
const forceDarkEffect = forcedHero ? (typeof forcedEffectValue === 'string' && forcedEffectValue.trim() ? forcedEffectValue.trim() : 'null') : ''
const comment = siteConfig.comment as { provider?: string, repo?: string, server?: string, serverURL?: string, envId?: string }
const commentOrigin = comment.provider === 'Giscus'
  ? 'https://giscus.app'
  : [comment.serverURL, comment.server, comment.envId].find(value => typeof value === 'string' && /^https?:\/\//.test(value))
const transition = siteConfig.transition as false | { page?: boolean }
const pageTransition = transition !== false && (typeof transition !== 'object' || transition.page !== false)
const katexCopy = (siteConfig.markdown.math as { type?: string, copy?: boolean }).type !== 'mathjax' && (siteConfig.markdown.math as { copy?: boolean }).copy === true
const markMode = (siteConfig.markdown as { mark?: 'lazy' | 'eager' }).mark === 'lazy' ? 'lazy' : undefined
type PhotoSwipeConfig = { selector?: string | string[], download?: boolean, fullscreen?: boolean, scrollToClose?: boolean }
const globalPhotoSwipe = (siteConfig.plugins as { photoSwipe?: false | PhotoSwipeConfig })?.photoSwipe
const pagePhotoSwipe = (entry?.data as { photoSwipe?: false | string | string[] } | undefined)?.photoSwipe
const photoSwipeConfig = globalPhotoSwipe === false || pagePhotoSwipe === false ? false : typeof globalPhotoSwipe === 'object' ? globalPhotoSwipe : {}
const photoSwipeSelector = photoSwipeConfig === false ? '' : (Array.isArray(pagePhotoSwipe) ? pagePhotoSwipe : Array.isArray(photoSwipeConfig.selector) ? photoSwipeConfig.selector : [typeof pagePhotoSwipe === 'string' ? pagePhotoSwipe : photoSwipeConfig.selector ?? '.vp-doc :not(a) > img:not([no-view],.no-view,.ignore)']).join(', ')
const markdownIcon = (siteConfig.markdown as { icon?: { provider?: string, assets?: string | string[] } }).icon ?? {}
const iconAssets = iconAssetUrls(markdownIcon)
const globalCredentials = (siteConfig.encrypt as { global?: boolean }).global ? globalAdminCredentials() : []
const globalEncryption = globalCredentials.length
  ? await Promise.all(globalCredentials.map(({ password, scope }) => encryptContent('ermaozi-global-unlock', password, scope)))
  : undefined
const customContent = hasUserSlot('custom-content')
const { password: _password, passwordHint: _passwordHint, ...publicFrontmatter } = entry?.data ?? {}
const clientPageData = JSON.stringify({ page: { path: route, title, description }, frontmatter: publicFrontmatter }).replaceAll('<', '\\u003c')
---

<!doctype html>
<html class:list={[!minimal404 && `layout-${layout}`, forceDark && 'force-dark dark', forceDarkEffect && `effect-${forceDarkEffect}`, { 'bg-gray': !minimal404 && layout === 'posts' }]} lang={lang} data-page-transition={pageTransition ? '' : undefined} data-katex-copy={katexCopy ? 'true' : undefined} data-mark-mode={markMode} data-photo-swipe-selector={photoSwipeSelector || undefined} data-photo-swipe-download={photoSwipeConfig !== false && photoSwipeConfig.download !== false ? 'true' : 'false'} data-photo-swipe-fullscreen={photoSwipeConfig !== false && photoSwipeConfig.fullscreen !== false ? 'true' : 'false'} data-photo-swipe-scroll-close={photoSwipeConfig !== false && photoSwipeConfig.scrollToClose !== false ? 'true' : 'false'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#336f87" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline define:vars={{ appearance, forceDark }}>
      (() => {
        const root = document.documentElement
        const stored = localStorage.getItem('vuepress-theme-appearance')
        const selected = stored || (appearance === 'dark' ? 'dark' : 'auto')
        const dark = forceDark || (appearance !== false && (selected === 'dark' || (selected !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)))
        root.dataset.theme = dark ? 'dark' : 'light'
        root.classList.toggle('dark', dark)
      })()
    </script>
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title set:html={fullTitle}></title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    {!minimal404 && alternates.map(item => <link rel="alternate" hreflang={item.lang} href={absoluteUrl(item.href)} />)}
    {!minimal404 && <link rel="alternate" hreflang="x-default" href={absoluteUrl(defaultRoute)} />}
    <link rel="icon" href={withBase('/img/logo.svg', import.meta.env.BASE_URL)} type="image/svg+xml" />
    {preconnectMedia && <link rel="preconnect" href={siteConfig.mediaOrigin} />}
    {iconAssets.filter(asset => asset.endsWith('.css')).map(asset => <link rel="stylesheet" href={asset} />)}
    {iconAssets.filter(asset => asset.endsWith('.js')).map(asset => <script is:inline src={asset} data-auto-replace-svg={markdownIcon.provider === 'fontawesome' ? 'nest' : undefined}></script>)}
    {siteConfig.features.comments && commentOrigin && <link rel="dns-prefetch" href={commentOrigin} />}
    {seoEnabled && !minimal404 && !generated && <meta property="og:title" content={title} />}
    {seoEnabled && !generated && <meta property="og:description" content={description} />}
    {seoEnabled && <meta property="og:url" content={canonical} />}
    {seoEnabled && <meta property="og:type" content={article ? 'article' : 'website'} />}
    {seoEnabled && <meta property="og:site_name" content={site.siteName} />}
    {seoEnabled && <meta property="og:locale" content={lang} />}
    {seoEnabled && alternates.filter(item => item.lang !== lang).map(item => <meta property="og:locale:alternate" content={item.lang} />)}
    {seoEnabled && !generated && <meta property="og:image" content={image} />}
    {seoEnabled && modified && <meta property="og:updated_time" content={modified} />}
    {seoEnabled && !generated && twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
    {seoEnabled && socialCover && <meta name="twitter:card" content="summary_large_image" />}
    {seoEnabled && socialCover && <meta name="twitter:image:src" content={image} />}
    {seoEnabled && socialCover && <meta name="twitter:image:alt" content={title} />}
    {seoEnabled && article && seoAuthors[0] && <meta property="article:author" content={seoAuthors[0].name} />}
    {seoEnabled && seoTags.toReversed().map(tag => <meta property="article:tag" content={tag} />)}
    {seoEnabled && published && <meta property="article:published_time" content={published} />}
    {seoEnabled && modified && <meta property="article:modified_time" content={modified} />}
    {seoEnabled && !generated && <meta property="og:image:alt" content={title} />}
    <meta name="keywords" content={keywords} />
    {seoEnabled && twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {siteConfig.verification.yandex && <meta name="yandex-verification" content={siteConfig.verification.yandex} />}
    {siteConfig.verification.baidu && <meta name="baidu-site-verification" content={siteConfig.verification.baidu} />}
    {metaHead.map(([, attrs]) => <meta {...attrs} />)}
    {linkHead.map(([, attrs]) => <link {...attrs} />)}
    {jsonLd[0] && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd[0])}></script>}
    {scriptHead.map(([, attrs, content]) => <script is:inline {...attrs} set:html={content ?? ''}></script>)}
    {jsonLd.slice(1).map(data => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)}></script>)}
  </head>
  <body data-pagefind-ignore={noindex ? 'all' : undefined} data-pagefind-ready={String(import.meta.env.PROD)}>
    <script is:inline id="ermaozi-page-data" type="application/json" set:html={clientPageData}></script>
    <div id="app">
      <div class:list={['theme-plume vp-layout', pageClass, { 'footer-no-border': singleHomeSection }]}>
        {globalEncryption && <GlobalEncrypt payloads={globalEncryption} {lang} />}
        <div class="global-protected" data-global-protected hidden={Boolean(globalEncryption)}>
          <UserSlot name="layout-top" {entry} {lang} {route} {layout} />
          <Header {lang} {translationRoute} {languageLinks} home={isHome} hasSidebar={entry?.data.type === 'doc' && entry.data.sidebar !== false} fixed={layout === 'posts'} />
          <Watermark options={watermarkOptions} title={site.siteName} />
          {customContent ? <UserSlot name="custom-content" {entry} {lang} {route} {layout} /> : <slot />}
          {showSignDown && <SignDown {lang} />}
          <Footer {lang} hasSidebar={entry?.data.type === 'doc' && entry.data.sidebar !== false} enabled={entry?.data.footer !== false} />
          <UserSlot name="layout-bottom" {entry} {lang} {route} {layout} />
          <BackToTop {lang} enabled={entry?.data.backToTop !== false && !shortHomeConfig} />
          <Bulletin pageEnabled={entry?.data.bulletin !== false} {lang} {route} />
        </div>
      </div>
    </div>
    {pageTransition && <script is:inline>
      (() => {
        const content = document.querySelector('#VPContent')
        if (!(content instanceof HTMLElement)) return
        const storageKey = '__ERMAOZI_PAGE_TRANSITION__'
        const classes = ['fade-slide-y-enter-from', 'fade-slide-y-enter-active', 'fade-slide-y-enter-to', 'fade-slide-y-leave-from', 'fade-slide-y-leave-active', 'fade-slide-y-leave-to']
        const reset = () => content.classList.remove(...classes)
        const timestamp = Number(sessionStorage.getItem(storageKey))
        sessionStorage.removeItem(storageKey)
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches && Date.now() - timestamp < 10_000) {
          content.classList.add('fade-slide-y-enter-from', 'fade-slide-y-enter-active')
          requestAnimationFrame(() => requestAnimationFrame(() => {
            content.classList.remove('fade-slide-y-enter-from')
            content.classList.add('fade-slide-y-enter-to')
            setTimeout(reset, 150)
          }))
        }
        addEventListener('pageshow', event => { if (event.persisted) reset() })
        let leaving = false
        document.addEventListener('click', event => {
          if (leaving || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
          const link = event.target instanceof Element ? event.target.closest('a[href]') : null
          if (!(link instanceof HTMLAnchorElement) || link.target && link.target !== '_self' || link.hasAttribute('download')) return
          if (link.closest('.vp-sidebar')) return
          const next = new URL(link.href, location.href)
          if (next.origin !== location.origin || !/^https?:$/.test(next.protocol) || next.pathname === location.pathname && next.search === location.search) return
          event.preventDefault()
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            location.href = next.href
            return
          }
          leaving = true
          content.classList.add('fade-slide-y-leave-from', 'fade-slide-y-leave-active')
          requestAnimationFrame(() => requestAnimationFrame(() => {
            content.classList.remove('fade-slide-y-leave-from')
            content.classList.add('fade-slide-y-leave-to')
            setTimeout(() => {
              sessionStorage.setItem(storageKey, String(Date.now()))
              location.href = next.href
            }, 150)
          }))
        })
      })()
    </script>}
    <script>
      import type { QRCodeByteSegment, QRCodeMaskPattern, QRCodeToDataURLOptions } from 'qrcode'
      import type PhotoSwipeInstance from 'photoswipe'
      import * as VueRuntime from 'vue'
      import { Watermark as PageWatermark } from 'watermark-js-plus'
      import '../client-config.ts'
      import { useEChartsConfig } from '../lib/echarts-config.ts'
      import { outlineOfHtml, type OutlineItem, type ThemeOutline } from '../lib/outline.ts'
      import { initPageNavigation } from '../lib/page-navigation.ts'

      initPageNavigation()

      if (document.documentElement.dataset.katexCopy === 'true') void import('katex/dist/contrib/copy-tex.min.js')

      if (document.documentElement.dataset.markMode === 'lazy') {
        const observer = new IntersectionObserver((entries, current) => {
          for (const entry of entries) if (entry.isIntersecting || entry.intersectionRatio > 0) {
            entry.target.classList.add('vp-mark-visible')
            entry.target.removeAttribute('data-vp-mark-bound')
            current.unobserve(entry.target)
          }
        }, { threshold: [0, .1, .25, .5], rootMargin: '8% 0px -8% 0px' })
        const bindMarks = () => document.querySelectorAll<HTMLElement>('mark:not(.vp-mark-visible):not([data-vp-mark-bound="1"])').forEach(mark => {
          mark.dataset.vpMarkBound = '1'
          observer.observe(mark)
        })
        bindMarks()
        document.addEventListener('plume-content-updated', () => requestAnimationFrame(bindMarks))
      }

      const loadRemoteIcons = async (root: ParentNode = document) => {
        const icons = [...root.querySelectorAll<HTMLElement>('[data-iconify-remote]:not([data-iconify-state])')]
        await Promise.all(icons.map(async icon => {
          const name = icon.dataset.iconifyRemote ?? ''
          const [collection, glyph] = name.split(':', 2)
          if (!collection || !glyph || !/^[\w-]+$/.test(collection) || !/^[\w-]+$/.test(glyph)) return
          icon.dataset.iconifyState = 'loading'
          try {
            const response = await fetch(`https://api.iconify.design/${encodeURIComponent(collection)}/${encodeURIComponent(glyph)}.svg`)
            if (!response.ok) throw new Error(`Iconify ${response.status}`)
            const parsed = new DOMParser().parseFromString(await response.text(), 'image/svg+xml')
            const svg = parsed.documentElement
            if (svg.localName !== 'svg' || parsed.querySelector('parsererror')) throw new Error('Invalid Iconify SVG')
            svg.querySelectorAll('script,style,foreignObject').forEach(node => node.remove())
            for (const element of [svg, ...svg.querySelectorAll('*')]) {
              for (const attribute of [...element.attributes]) {
                if (/^on/i.test(attribute.name) || (/^(?:href|xlink:href)$/i.test(attribute.name) && !attribute.value.startsWith('#'))) element.removeAttribute(attribute.name)
              }
            }
            svg.setAttribute('width', '100%')
            svg.setAttribute('height', '100%')
            svg.setAttribute('aria-hidden', 'true')
            icon.replaceChildren(document.importNode(svg, true))
            icon.dataset.iconifyState = 'ready'
          } catch { icon.dataset.iconifyState = 'error' }
        }))
      }
      void loadRemoteIcons()
      document.addEventListener('plume-content-updated', event => {
        const target = event.target
        void loadRemoteIcons(target instanceof Element || target instanceof DocumentFragment ? target : document)
      })

      const selectTab = (button: HTMLButtonElement, persist = true) => {
        const tabs = button.closest<HTMLElement>('[data-tabs]')
        if (!tabs) return
        const index = Number(button.dataset.tabIndex)
        const buttonSelector = tabs.dataset.tabKind === 'code' ? '.vp-code-tab-nav' : '.vp-tab-nav'
        const panelSelector = tabs.dataset.tabKind === 'code' ? '.vp-code-tab' : '.vp-tab'
        tabs.querySelectorAll<HTMLButtonElement>(buttonSelector).forEach((item, itemIndex) => {
          item.setAttribute('aria-selected', String(itemIndex === index))
          item.tabIndex = itemIndex === index ? 0 : -1
          item.classList.toggle('active', itemIndex === index)
        })
        tabs.querySelectorAll<HTMLElement>(panelSelector).forEach((panel, panelIndex) => {
          panel.classList.toggle('active', panelIndex === index)
          panel.setAttribute('aria-expanded', String(panelIndex === index))
        })
        const tabId = tabs.dataset.tabId
        if (!persist || !tabId) return
        const storeName = tabs.dataset.tabStore ?? 'VUEPRESS_TAB_STORE'
        let store: Record<string, string> = {}
        try { store = JSON.parse(localStorage.getItem(storeName) || '{}') }
        catch { /* ignore invalid user storage */ }
        store[tabId] = button.dataset.tabValue ?? ''
        localStorage.setItem(storeName, JSON.stringify(store))
        document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(group => {
          if (group === tabs || group.dataset.tabStore !== storeName || group.dataset.tabId !== tabId) return
          const match = [...group.querySelectorAll<HTMLButtonElement>('[data-tab-value]')].find(item => item.dataset.tabValue === store[tabId])
          if (match) selectTab(match, false)
        })
      }

      const restoreTabs = (storeName?: string) => document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(tabs => {
        const tabId = tabs.dataset.tabId
        if (!tabId || (storeName && tabs.dataset.tabStore !== storeName)) return
        let value = ''
        try { value = JSON.parse(localStorage.getItem(tabs.dataset.tabStore ?? 'VUEPRESS_TAB_STORE') || '{}')[tabId] ?? '' }
        catch { /* ignore invalid user storage */ }
        const button = [...tabs.querySelectorAll<HTMLButtonElement>('[data-tab-value]')].find(item => item.dataset.tabValue === value)
        if (button) selectTab(button, false)
      })
      restoreTabs()
      addEventListener('storage', event => {
        if (event.key === 'VUEPRESS_TAB_STORE' || event.key === 'VUEPRESS_CODE_TAB_STORE') restoreTabs(event.key)
      })

      let collapseTransitionId = 0
      const setCollapse = (item: HTMLElement, button: HTMLButtonElement, content: HTMLElement, expanded: boolean) => {
        const token = String(++collapseTransitionId)
        content.dataset.collapseTransition = token
        content.classList.remove(
          'fade-in-height-expand-enter-from',
          'fade-in-height-expand-enter-active',
          'fade-in-height-expand-enter-to',
          'fade-in-height-expand-leave-from',
          'fade-in-height-expand-leave-active',
          'fade-in-height-expand-leave-to',
        )
        content.style.removeProperty('max-height')
        content.style.removeProperty('transition')
        item.classList.toggle('expanded', expanded)
        button.setAttribute('aria-expanded', String(expanded))
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          content.hidden = !expanded
          return
        }

        const phase = expanded ? 'enter' : 'leave'
        const from = `fade-in-height-expand-${phase}-from`
        const active = `fade-in-height-expand-${phase}-active`
        const to = `fade-in-height-expand-${phase}-to`
        const finish = () => {
          if (content.dataset.collapseTransition !== token) return
          content.classList.remove(from, active, to)
          content.style.removeProperty('max-height')
          if (!expanded) content.hidden = true
        }
        const onEnd = (event: TransitionEvent) => {
          if (event.propertyName !== 'max-height') return
          content.removeEventListener('transitionend', onEnd)
          finish()
        }
        content.addEventListener('transitionend', onEnd)
        setTimeout(finish, 350)

        if (expanded) {
          content.hidden = false
          content.classList.add(from, active)
          const height = content.scrollHeight
          content.style.transition = 'none'
          content.style.maxHeight = '0'
          content.offsetWidth
          content.style.removeProperty('transition')
          content.style.maxHeight = `${height}px`
          content.offsetWidth
        } else {
          content.style.maxHeight = `${content.offsetHeight}px`
          content.offsetWidth
          content.classList.add(from, active)
        }
        requestAnimationFrame(() => requestAnimationFrame(() => {
          if (content.dataset.collapseTransition !== token) return
          content.classList.remove(from)
          content.classList.add(to)
          if (!expanded) content.style.maxHeight = '0'
        }))
      }

      const selectCodeTreeFile = (button: HTMLElement) => {
        const tree = button.closest<HTMLElement>('[data-code-tree]')
        if (!tree) return
        const filepath = button.dataset.codeFile ?? ''
        let matched = false
        tree.querySelectorAll<HTMLElement>('[data-code-file]').forEach(item => item.classList.toggle('active', item.dataset.codeFile === filepath))
        tree.querySelectorAll<HTMLElement>('.code-panel > .code-block-title').forEach(block => {
          const active = block.dataset.title === filepath
          block.classList.toggle('active', active)
          matched ||= active
        })
        const empty = tree.querySelector<HTMLElement>('.code-tree-empty')
        if (empty) empty.hidden = matched
      }

      const decodeBase64 = (value: string) => Uint8Array.from(atob(value), character => character.charCodeAt(0))
      const decodeHtml = (value = '') => new TextDecoder().decode(decodeBase64(value))
      const floatingDuration = 200
      const enterFloating = (element: HTMLElement) => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
        element.classList.add('fade-in-enter-active', 'fade-in-enter-from')
        element.offsetWidth
        requestAnimationFrame(() => {
          element.classList.replace('fade-in-enter-from', 'fade-in-enter-to')
          setTimeout(() => element.classList.remove('fade-in-enter-active', 'fade-in-enter-to'), floatingDuration)
        })
      }
      const leaveFloating = (element: HTMLElement, immediate = false) => {
        if (immediate || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          element.remove()
          return
        }
        element.classList.remove('fade-in-enter-active', 'fade-in-enter-from', 'fade-in-enter-to')
        element.classList.add('fade-in-leave-active', 'fade-in-leave-from')
        element.offsetWidth
        requestAnimationFrame(() => element.classList.replace('fade-in-leave-from', 'fade-in-leave-to'))
        setTimeout(() => element.remove(), floatingDuration)
      }
      const placeFloating = (anchor: HTMLElement, floating: HTMLElement, gap: number, padding: number, flip = false) => {
        const bounds = anchor.getBoundingClientRect()
        const floatingBounds = floating.getBoundingClientRect()
        let placement = 'bottom'
        let top = bounds.bottom + scrollY + gap
        const bottomOverflow = Math.max(0, top + floatingBounds.height - scrollY - innerHeight)
        const topPosition = bounds.top + scrollY - floatingBounds.height - gap
        const topOverflow = Math.max(0, scrollY - topPosition)
        if (flip && bottomOverflow > 0 && topOverflow < bottomOverflow) {
          placement = 'top'
          top = topPosition
        }
        const left = Math.min(
          Math.max(bounds.left + scrollX + bounds.width / 2 - floatingBounds.width / 2, scrollX + padding),
          scrollX + innerWidth - floatingBounds.width - padding,
        )
        floating.style.position = 'absolute'
        floating.style.left = '0'
        floating.style.top = '0'
        floating.style.transform = `translate(${left}px, ${top}px)`
        return { placement, left, bounds }
      }

      let activeAbbreviation: HTMLElement | null = null
      let abbreviationTooltip: HTMLElement | null = null
      const hideAbbreviation = (immediate = false) => {
        if (abbreviationTooltip) leaveFloating(abbreviationTooltip, immediate)
        activeAbbreviation = null
        abbreviationTooltip = null
      }
      const positionAbbreviation = () => {
        if (!activeAbbreviation || !abbreviationTooltip) return
        const { left, bounds } = placeFloating(activeAbbreviation, abbreviationTooltip, 10, 20)
        const arrow = abbreviationTooltip.querySelector<HTMLElement>('.tooltip-arrow')
        if (arrow) {
          const border = (abbreviationTooltip.offsetWidth - abbreviationTooltip.clientWidth) / 2
          const centered = bounds.left + scrollX + bounds.width / 2 - left - border - arrow.offsetWidth / 2
          arrow.style.left = `${Math.min(Math.max(centered, 4), abbreviationTooltip.clientWidth - arrow.offsetWidth - 4)}px`
        }
      }
      const showAbbreviation = (abbreviation: HTMLElement) => {
        if (activeAbbreviation === abbreviation && abbreviationTooltip) return
        hideAbbreviation(true)
        const tooltip = document.createElement('span')
        tooltip.className = 'vp-abbr-tooltip ignore-header'
        tooltip.setAttribute('aria-hidden', 'true')
        tooltip.innerHTML = `<span class="tooltip-arrow"></span>${decodeHtml(abbreviation.dataset.abbrContent)}`
        document.body.append(tooltip)
        activeAbbreviation = abbreviation
        abbreviationTooltip = tooltip
        positionAbbreviation()
        enterFloating(tooltip)
      }

      let activeAnnotation: HTMLButtonElement | null = null
      let annotationPopover: HTMLElement | null = null
      const hideAnnotation = (immediate = false) => {
        if (activeAnnotation) {
          activeAnnotation.classList.remove('active')
          activeAnnotation.setAttribute('aria-expanded', 'false')
        }
        if (annotationPopover) leaveFloating(annotationPopover, immediate)
        activeAnnotation = null
        annotationPopover = null
      }
      const positionAnnotation = () => {
        if (!activeAnnotation || !annotationPopover) return
        const { placement } = placeFloating(activeAnnotation, annotationPopover, 0, 16, true)
        activeAnnotation.classList.remove('top', 'left', 'bottom', 'right')
        activeAnnotation.classList.add(placement)
      }
      const showAnnotation = (button: HTMLButtonElement) => {
        if (activeAnnotation === button && annotationPopover) return
        hideAnnotation(true)
        const popover = document.createElement('div')
        popover.className = `vp-annotation-popover${Number(button.dataset.annotationTotal) > 1 ? ' group' : ''}`
        popover.innerHTML = decodeHtml(button.dataset.annotationContent)
        document.body.append(popover)
        activeAnnotation = button
        annotationPopover = popover
        button.classList.add('active')
        button.setAttribute('aria-expanded', 'true')
        positionAnnotation()
        enterFloating(popover)
      }

      document.addEventListener('mouseover', event => {
        if (innerWidth <= 768 || !(event.target instanceof Element)) return
        const abbreviation = event.target.closest<HTMLElement>('.vp-abbr')
        if (abbreviation && (!(event.relatedTarget instanceof Node) || !abbreviation.contains(event.relatedTarget))) showAbbreviation(abbreviation)
      })
      document.addEventListener('mouseout', event => {
        if (innerWidth <= 768 || !(event.target instanceof Element)) return
        const abbreviation = event.target.closest<HTMLElement>('.vp-abbr')
        if (abbreviation) {
          if (event.relatedTarget instanceof Node && abbreviation.contains(event.relatedTarget)) return
          setTimeout(() => {
            if (!activeAbbreviation?.matches(':hover') && !abbreviationTooltip?.matches(':hover')) hideAbbreviation()
          })
          return
        }
        const tooltip = event.target.closest<HTMLElement>('.vp-abbr-tooltip')
        if (tooltip && (!(event.relatedTarget instanceof Node) || !tooltip.contains(event.relatedTarget))) hideAbbreviation()
      })
      document.addEventListener('focusin', event => {
        if (innerWidth > 768 && event.target instanceof HTMLElement && event.target.matches('.vp-abbr')) showAbbreviation(event.target)
      })
      document.addEventListener('focusout', event => {
        if (innerWidth <= 768 || !(event.target instanceof HTMLElement) || !event.target.matches('.vp-abbr')) return
        setTimeout(() => {
          if (!activeAbbreviation?.matches(':focus') && !abbreviationTooltip?.matches(':hover')) hideAbbreviation()
        })
      })
      const updateFloating = () => {
        positionAbbreviation()
        if (activeAnnotation) {
          const bounds = activeAnnotation.getBoundingClientRect()
          if (bounds.bottom <= 64 || bounds.top >= innerHeight) hideAnnotation()
          else positionAnnotation()
        }
      }
      addEventListener('resize', updateFloating)
      addEventListener('scroll', updateFloating, true)

      const decryptContent = async (element: HTMLElement, password = '') => {
        const fallback = [{ ciphertext: element.dataset.encryptCiphertext ?? '', iv: element.dataset.encryptIv ?? '', salt: element.dataset.encryptSalt ?? '' }]
        const payloads = element.dataset.encryptPayloads ? JSON.parse(element.dataset.encryptPayloads) : fallback
        for (const payload of payloads) {
          const cacheKey = `plume:decrypt:${payload.salt}`
          const cached = sessionStorage.getItem(cacheKey)
          try {
            let key: CryptoKey
            if (cached) key = await crypto.subtle.importKey('raw', decodeBase64(cached), 'AES-GCM', false, ['decrypt'])
            else {
              if (!password) continue
              const material = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey'])
              key = await crypto.subtle.deriveKey(
                { name: 'PBKDF2', salt: decodeBase64(payload.salt), iterations: 100_000, hash: 'SHA-256' },
                material,
                { name: 'AES-GCM', length: 256 },
                true,
                ['decrypt'],
              )
            }
            const content = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: decodeBase64(payload.iv) }, key, decodeBase64(payload.ciphertext))
            if (!cached) {
              const rawKey = new Uint8Array(await crypto.subtle.exportKey('raw', key))
              sessionStorage.setItem(cacheKey, btoa(String.fromCharCode(...rawKey)))
            }
            return new TextDecoder().decode(content)
          } catch {
            continue
          }
        }
        throw new Error('Invalid password')
      }

      const unlockEncrypted = async (element: HTMLElement, password = '') => {
        const html = await decryptContent(element, password)
        if (element.matches('[data-global-encrypt]')) {
          document.querySelectorAll<HTMLElement>('[data-global-protected]').forEach(content => { content.hidden = false })
          element.remove()
          document.querySelectorAll<HTMLElement>('[data-page-encrypt], [data-encrypt-snippet]').forEach(content => { void unlockEncrypted(content).catch(() => {}) })
        } else if (element.matches('[data-page-encrypt]')) {
          const content = document.querySelector<HTMLElement>('[data-page-decrypted]')
          if (content) {
            content.innerHTML = html
            content.hidden = false
          }
          document.querySelectorAll<HTMLElement>('[data-page-protected]').forEach(protectedContent => { protectedContent.hidden = false })
          element.remove()
        } else {
          const template = document.createElement('template')
          template.innerHTML = html
          const content = document.createElement('div')
          content.className = 'decrypted-content'
          content.append(template.content)
          element.replaceWith(content)
        }
        document.dispatchEvent(new CustomEvent('plume-content-updated'))
      }

      const photoSwipeSelector = document.documentElement.dataset.photoSwipeSelector ?? ''
      const photoSwipeLoading = '<div class="photo-swipe-loading"><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" preserveAspectRatio="xMidYMid" viewBox="25 25 50 50"><animateTransform attributeName="transform" type="rotate" dur="2s" keyTimes="0;1" repeatCount="indefinite" values="0;360"></animateTransform><circle cx="50" cy="50" r="20" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"><animate attributeName="stroke-dasharray" dur="1.5s" keyTimes="0;0.5;1" repeatCount="indefinite" values="1,200;90,200;1,200"></animate><animate attributeName="stroke-dashoffset" dur="1.5s" keyTimes="0;0.5;1" repeatCount="indefinite" values="0;-35px;-125px"></animate></circle></svg></div>'
      let activePhotoSwipe: PhotoSwipeInstance | null = null
      const photoSwipeLoader = photoSwipeSelector ? import('photoswipe').then(module => module.default) : null
      const registerPhotoSwipeUi = (viewer: PhotoSwipeInstance) => viewer.on('uiRegister', () => {
        viewer.ui?.registerElement({
          name: 'bulletsIndicator',
          className: 'photo-swipe-bullets-indicator',
          appendTo: 'wrapper',
          onInit: element => {
            const bullets = Array.from({ length: viewer.getNumItems() }, (_, index) => {
              const bullet = document.createElement('button')
              bullet.className = 'photo-swipe-bullet'
              bullet.type = 'button'
              bullet.ariaLabel = String(index + 1)
              bullet.addEventListener('click', () => viewer.goTo(index))
              element.append(bullet)
              return bullet
            })
            viewer.on('change', () => bullets.forEach((bullet, index) => bullet.classList.toggle('active', index === viewer.currIndex)))
          },
        })
        if (document.documentElement.dataset.photoSwipeFullscreen === 'true' && document.fullscreenEnabled) viewer.ui?.registerElement({
          name: 'fullscreen', order: 7, isButton: true, title: document.documentElement.lang.startsWith('zh') ? '切换全屏' : 'Switch to fullscreen',
          html: '<svg class="pswp__icn" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg"><path d="M249.5 270.833H437v-75H212a37.5 37.5 0 0 0-37.5 37.5v225h75v-187.5zm-37.5 600h225v-75H249.5v-187.5h-75v225a37.5 37.5 0 0 0 37.5 37.5zm637.5-37.5v-225h-75v187.5H587v75h225a37.5 37.5 0 0 0 37.5-37.5zM587 270.833h187.5v187.5h75v-225a37.5 37.5 0 0 0-37.5-37.5H587v75z"/></svg>',
          onClick: () => { void (document.fullscreenElement ? document.exitFullscreen() : viewer.element?.requestFullscreen()) },
        })
        if (document.documentElement.dataset.photoSwipeDownload === 'true') viewer.ui?.registerElement({
          name: 'download', order: 8, isButton: true, tagName: 'a', title: document.documentElement.lang.startsWith('zh') ? '下载图片' : 'Download Image',
          html: { isCustomSVG: true, inner: '<path d="M20.5 14.3 17.1 18V10h-2.2v7.9l-3.4-3.6L10 16l6 6.1 6-6.1-1.5-1.6ZM23 23H9v2h14" id="pswp__icn-download"/>', outlineID: 'pswp__icn-download' },
          onInit: element => {
            element.setAttribute('download', '')
            element.setAttribute('target', '_blank')
            element.setAttribute('rel', 'noopener')
            viewer.on('change', () => element.setAttribute('href', String(viewer.currSlide?.data.src ?? '')))
          },
        })
      })
      const openPhotoSwipe = async (image: HTMLImageElement) => {
        if (!photoSwipeLoader) return
        activePhotoSwipe?.destroy()
        const PhotoSwipe = await photoSwipeLoader
        const images = [...document.querySelectorAll<HTMLImageElement>(photoSwipeSelector)]
        const dataSource: any[] = images.map(element => ({ html: photoSwipeLoading, element, msrc: element.src }))
        const chinese = document.documentElement.lang.startsWith('zh')
        const viewer = new PhotoSwipe({
          preloaderDelay: 0,
          showHideAnimationType: 'zoom',
          dataSource,
          index: images.indexOf(image),
          closeOnVerticalDrag: document.documentElement.dataset.photoSwipeScrollClose === 'true',
          wheelToZoom: document.documentElement.dataset.photoSwipeScrollClose !== 'true',
          closeTitle: chinese ? '关闭' : 'Close',
          zoomTitle: chinese ? '缩放' : 'Zoom in/out',
          arrowPrevTitle: chinese ? '上一个 (左箭头)' : 'Prev (Arrow Left)',
          arrowNextTitle: chinese ? '下一个 (右箭头)' : 'Next (Arrow Right)',
        })
        activePhotoSwipe = viewer
        registerPhotoSwipeUi(viewer)
        viewer.init()
        viewer.on('destroy', () => { if (activePhotoSwipe === viewer) activePhotoSwipe = null })
        images.forEach((element, index) => { void element.decode().then(() => {
          if (activePhotoSwipe !== viewer) return
          dataSource.splice(index, 1, { type: 'image', element, src: element.src, width: element.naturalWidth, height: element.naturalHeight, alt: element.alt, msrc: element.src })
          viewer.refreshSlideContent(index)
        }).catch(() => {}) })
      }
      if (photoSwipeLoader && 'requestIdleCallback' in window) window.requestIdleCallback(() => { void photoSwipeLoader })
      addEventListener('wheel', () => { if (document.documentElement.dataset.photoSwipeScrollClose === 'true') setTimeout(() => activePhotoSwipe?.close()) }, { passive: true, capture: true })

      document.addEventListener('click', event => {
        if (!(event.target instanceof Element)) return
        const tab = event.target.closest<HTMLButtonElement>('.vp-tab-nav, .vp-code-tab-nav')
        if (tab) selectTab(tab)

        const collapseButton = event.target.closest<HTMLButtonElement>('.vp-collapse-header')
        if (collapseButton) {
          const item = collapseButton.closest<HTMLElement>('.vp-collapse-item')
          const content = item?.querySelector<HTMLElement>('.vp-collapse-content')
          if (!item || !content) return
          const expanded = collapseButton.getAttribute('aria-expanded') !== 'true'
          if (expanded && item.parentElement?.hasAttribute('data-accordion')) {
            item.parentElement.querySelectorAll<HTMLElement>('.vp-collapse-item.expanded').forEach(openItem => {
              if (openItem === item) return
              const openButton = openItem.querySelector<HTMLButtonElement>('.vp-collapse-header')
              const openContent = openItem.querySelector<HTMLElement>('.vp-collapse-content')
              if (openButton && openContent) setCollapse(openItem, openButton, openContent, false)
            })
          }
          setCollapse(item, collapseButton, content, expanded)
        }

        const collapsedLines = event.target.closest<HTMLElement>('.collapsed-lines')
        if (collapsedLines) {
          const block = collapsedLines.closest<HTMLElement>('.has-collapsed-lines')
          if (block) {
            const collapsed = block.classList.toggle('collapsed')
            collapsedLines.setAttribute('aria-expanded', String(!collapsed))
            if (collapsed) block.scrollIntoView({ block: 'center', behavior: 'instant' })
          }
        }

        const abbreviation = event.target.closest<HTMLElement>('.vp-abbr')
        if (abbreviation && innerWidth <= 768) {
          if (activeAbbreviation === abbreviation) hideAbbreviation()
          else showAbbreviation(abbreviation)
        } else if (!event.target.closest('.vp-abbr-tooltip') && innerWidth <= 768) hideAbbreviation()

        const plot = event.target.closest<HTMLElement>('.vp-plot.click')
        document.querySelectorAll<HTMLElement>('.vp-plot.click.active').forEach(item => {
          if (item !== plot) item.classList.remove('active')
        })
        if (plot) plot.classList.toggle('active')

        const annotationButton = event.target.closest<HTMLButtonElement>('.vp-annotation')
        if (annotationButton) {
          if (activeAnnotation === annotationButton) hideAnnotation()
          else showAnnotation(annotationButton)
        } else if (!event.target.closest('.vp-annotation-popover')) hideAnnotation()

        const folder = event.target.closest<HTMLElement>('.vp-file-tree-info.folder')
        if (folder && !event.target.closest('.comment')) {
          const expanded = !folder.classList.contains('expanded')
          folder.classList.toggle('expanded', expanded)
          folder.setAttribute('aria-expanded', String(expanded))
        }

        const codeTreeFile = event.target.closest<HTMLElement>('.vp-code-tree .vp-file-tree-info.file')
        if (codeTreeFile) selectCodeTreeFile(codeTreeFile)

        const preview = event.target.closest<HTMLButtonElement>('.mermaid-actions .preview-button')
        if (preview) {
          const svg = preview.parentElement?.nextElementSibling?.querySelector('svg')
          if (!svg) return
          const overlay = document.createElement('div')
          overlay.className = 'mermaid-preview'
          overlay.append(svg.cloneNode(true))
          overlay.addEventListener('click', () => overlay.remove(), { once: true })
          document.body.append(overlay)
        }

        const download = event.target.closest<HTMLButtonElement>('.mermaid-actions .download-button')
        if (download) {
          const wrapper = download.parentElement?.nextElementSibling as HTMLElement | null
          const svg = wrapper?.querySelector('svg')
          if (!wrapper || !svg) return
          const blob = new Blob([new XMLSerializer().serializeToString(svg)], { type: 'image/svg+xml' })
          const url = URL.createObjectURL(blob)
          const link = document.createElement('a')
          link.href = url
          link.download = `${wrapper.dataset.mermaidTitle || wrapper.dataset.mermaidId || 'mermaid'}.svg`
          link.click()
          URL.revokeObjectURL(url)
        }

        const copyCode = event.target.closest<HTMLButtonElement>('[data-copy-code]')
        if (copyCode) {
          const block = copyCode.closest<HTMLElement>('div[class*="language-"]')
          const code = block?.querySelector('pre')?.cloneNode(true) as HTMLElement | undefined
          if (!block || !code) return
          code.querySelectorAll('.line-numbers, .collapsed-lines, .vp-copy-ignore, .diff.remove').forEach(element => element.remove())
          let text = code.textContent ?? ''
          if (/language-(?:shellscript|shell|bash|sh|zsh)/u.test(block.className)) text = text.replaceAll(/^ *(?:\$|>) /gmu, '')
          void navigator.clipboard.writeText(text).then(() => {
            const duration = Number(copyCode.dataset.copyDuration)
            if (!(duration > 0)) return
            copyCode.classList.add('copied')
            setTimeout(() => { copyCode.classList.remove('copied'); copyCode.blur() }, duration)
          })
        }

        const tableButton = event.target.closest<HTMLButtonElement>('[data-copy-table]')
        if (tableButton) {
          const table = tableButton.closest('.vp-table')?.querySelector('table')
          if (!table) return
          const rows = [...table.querySelectorAll('tr')].map(row => [...row.querySelectorAll('th, td')].map(cell => cell.textContent?.trim() ?? ''))
          const text = tableButton.dataset.copyTable === 'html'
            ? table.closest('.table-inner')?.innerHTML ?? table.outerHTML
            : rows.map((row, index) => `| ${row.join(' | ')} |${index === 0 ? `\n| ${row.map(() => '---').join(' | ')} |` : ''}`).join('\n')
          void navigator.clipboard.writeText(text).then(() => {
            const icon = tableButton.querySelector('span')
            icon?.classList.replace('vpi-table-copy', 'vpi-table-copied')
            setTimeout(() => { icon?.classList.replace('vpi-table-copied', 'vpi-table-copy') }, 1500)
          })
