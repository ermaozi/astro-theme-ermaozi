        const storage = lifetime === 'once' ? localStorage : lifetime === 'session' ? sessionStorage : null
        const key = 'plume:bulletin'
        bulletin.hidden = Boolean(storage && storage.getItem(key) === bulletin.dataset.bulletinId)
        const transition = (phase: 'enter' | 'leave', done?: () => void) => {
          const active = `fade-in-scale-up-${phase}-active`
          const from = `fade-in-scale-up-${phase}-from`
          const to = `fade-in-scale-up-${phase}-to`
          let finished = false
          const clear = () => {
            if (finished) return
            finished = true
            bulletin.classList.remove(active, from, to)
            done?.()
          }
          bulletin.classList.add(active, from)
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return clear()
          void bulletin.offsetHeight
          bulletin.classList.replace(from, to)
          bulletin.addEventListener('transitionend', clear, { once: true })
          setTimeout(clear, 250)
        }
        if (!bulletin.hidden) transition('enter')
        bulletin.querySelector<HTMLButtonElement>('.close')?.addEventListener('click', () => {
          if (storage) storage.setItem(key, bulletin.dataset.bulletinId ?? '')
          transition('leave', () => { bulletin.hidden = true })
