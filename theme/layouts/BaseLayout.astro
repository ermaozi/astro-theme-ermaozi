            const requireDemoDependency = (specifier: string) => {
              if (specifier === 'vue') return VueRuntime
              throw new Error(`Unsupported external Vue demo dependency: ${specifier}`)
            }
            Function('require', 'module', 'exports', decodeDemoValue(demo.dataset.demoVueCode))(requireDemoDependency, module, module.exports)
            const component = module.exports.default
            if (!component) throw new Error('Vue demo did not export a component')
            const app = VueRuntime.createApp(component)
            app.mount(mount)
            ;(demo as HTMLElement & { __vueDemoApp?: typeof app }).__vueDemoApp = app
            demo.dataset.demoReady = 'true'
          } catch (error) {
