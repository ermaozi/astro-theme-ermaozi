      })

      const setupPlots = (root: ParentNode = document) => {
        root.querySelectorAll<HTMLElement>('.vp-plot:not([data-plot-ready])').forEach(plot => {
          if (innerWidth <= 768 && plot.dataset.plotDefaultTrigger === 'true') plot.classList.replace('hover', 'click')
