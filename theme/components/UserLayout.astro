---
import { userLayoutComponent } from '../lib/user-slots'

const { name, content, ...props } = Astro.props as { name?: string, content: string, [key: string]: unknown }
const Component = name ? userLayoutComponent(name) : undefined
if (name && !Component) throw new Error(`[ermaozi] pageLayout "${name}" 未找到对应组件；请添加 theme/components/layouts/${name}.astro 或 .vue`)
---

{Component ? <Component content={content} {...props} /> : <Fragment set:html={content} />}
