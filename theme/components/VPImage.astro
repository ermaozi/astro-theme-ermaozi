---
import { withBase } from '../lib/client-utils'

type ImageSource = string | { src?: string, light?: string | ImageSource, dark?: string | ImageSource, alt?: string, width?: string | number, height?: string | number }
const { image, alt, class: className = '', ...attributes } = Astro.props as { image: ImageSource, alt?: string, class?: string, [key: string]: unknown }
const source = typeof image === 'string' ? { src: image } : image
const unit = (value?: string | number) => typeof value === 'number' ? `${value}px` : value
const style = source?.width && source?.height ? `width:${unit(source.width)};height:${unit(source.height)}` : undefined
const sourceAttributes = source && 'src' in source
  ? Object.fromEntries(Object.entries(source).filter(([key]) => !['src', 'alt', 'width', 'height', 'light', 'dark'].includes(key)))
  : {}
const src = source && 'src' in source ? withBase(source.src ?? '', import.meta.env.BASE_URL) : ''
---

{source && ('src' in source || typeof image === 'string')
  ? <img {...sourceAttributes} class:list={['vp-image', className]} {src} alt={alt ?? source.alt ?? ''} width={source.width} height={source.height} {style} {...attributes} />
  : source && <><Astro.self class:list={['dark', className]} image={source.dark!} alt={alt ?? source.alt} {...attributes} /><Astro.self class:list={['light', className]} image={source.light!} alt={alt ?? source.alt} {...attributes} /></>}
