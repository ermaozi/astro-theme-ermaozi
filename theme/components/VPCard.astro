---
import ThemeIcon from './ThemeIcon.astro'

const { title, icon = '', class: className = '', ...attrs } = Astro.props
let iconName = icon
if (typeof icon === 'string' && icon[0] === '{') {
  try { iconName = JSON.parse(icon) }
  catch {}
}
---

<article {...attrs} class:list={['vp-card-wrapper', className]}>
  <slot name="title">
    {(title || icon) && <header class="title">
      {icon && <ThemeIcon name={iconName} />}
      {title && <span class="text" set:html={title}></span>}
    </header>}
  </slot>
  <section class="body"><slot /></section>
</article>
