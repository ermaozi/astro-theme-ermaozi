---
import VPButton from './VPButton.astro'
import VPImage from './VPImage.astro'

const { hero = {} } = Astro.props
const actions = hero.actions ?? []
---

<div class:list={['vp-home-doc-hero', { 'has-image': hero.image }]}>
  <div class="doc-hero-container">
    <div class="doc-hero-main">
      <h1 class="heading">
        {hero.name && <span class="name clip" set:html={hero.name}></span>}
        {hero.text && <span class="text" set:html={hero.text}></span>}
      </h1>
      {hero.tagline && <p class="tagline" set:html={hero.tagline}></p>}
      {actions.length > 0 && <div class="actions"><div class="action">
        {actions.map((action: any) => <VPButton tag="a" size="medium" theme={action.theme} text={action.text} href={action.link} target={action.target} rel={action.rel} icon={action.icon} suffixIcon={action.suffixIcon} />)}
      </div></div>}
    </div>
    {hero.image && <div class="image"><div class="image-container">
      <div class="image-bg"></div>
      <slot name="home-doc-hero-image"><VPImage class="image-src" image={hero.image} /></slot>
    </div></div>}
  </div>
</div>
