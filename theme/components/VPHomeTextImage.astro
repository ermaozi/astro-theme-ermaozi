---
import VPHomeBox from './VPHomeBox.astro'
import VPImage from './VPImage.astro'

const { width, title, description, list, image, type, ...boxProps } = Astro.props
const maxWidth = typeof width === 'number' ? `${width}px` : width
---

<VPHomeBox class="vp-home-text-image" containerClass={type === 'text-image' ? 'reverse' : ''} {...boxProps}>
  <div class="content-image"><VPImage {image} style={maxWidth ? `max-width:${maxWidth}` : undefined} /></div>
  <div class="content-text vp-doc"><section>
    {title && <h2 class="title">{title}</h2>}
    {description && <p class="description" set:html={description}></p>}
    {list?.length > 0 && <ul class="list">{list.map((item: any) => <li>{typeof item === 'object' ? <>{item.title && <h3 set:html={item.title}></h3>}{item.description && <p set:html={item.description}></p>}</> : <p set:html={item}></p>}</li>)}</ul>}
  </section></div>
</VPHomeBox>
