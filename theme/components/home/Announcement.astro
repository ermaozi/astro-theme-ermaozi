---
import VPHomeBox from '../VPHomeBox.astro'

const { title = 'Announcement', description = '', ...box } = Astro.props
---

<VPHomeBox {...box} class="vp-home-announcement" containerClass="vp-doc">
  <aside data-user-home-component>
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </aside>
</VPHomeBox>
