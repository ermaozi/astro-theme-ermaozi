---
import type { EncryptedContent } from '../lib/encryption'
import Footer from './Footer.astro'
import { siteConfig } from '../../site.config.mjs'
import type { Lang } from '../lib/content'
import { localeOf } from '../lib/locales'
import { withBase } from '../lib/client-utils'

const { payloads, lang } = Astro.props as { payloads: EncryptedContent[], lang: Lang }
const locale = localeOf(lang)
const profileConfig = (locale.profile ?? siteConfig.profile) as false | { avatar?: string, circle?: boolean, name?: string }
const profile = profileConfig === false ? undefined : profileConfig
const title = profile?.name || locale.siteName
const first = payloads[0]
---

<div class="global-encrypt-shell" data-global-encrypt data-encrypt-ciphertext={first.ciphertext} data-encrypt-iv={first.iv} data-encrypt-salt={first.salt} data-encrypt-payloads={JSON.stringify(payloads)}>
  <div class="vp-global-encrypt">
    <div class="global-encrypt-container">
      {(profile || title) && <div class="profile">
        {profile && <p class:list={['avatar', { circle: profile.circle }]}><img src={withBase(profile.avatar || locale.logo || siteConfig.logo, import.meta.env.BASE_URL)} alt={profile.name || title} /></p>}
        {title && <h3>{title}</h3>}
      </div>}
      <div class="vp-encrypt-form">
        <p class="encrypt-text" set:html={locale.encryptGlobalText}></p>
        <p class="encrypt-input-wrapper"><label for="encrypt-input"><span class="vpi-lock icon-lock" aria-hidden="true"></span><input id="encrypt-input" class="encrypt-input" type="password" autocomplete="off" placeholder={locale.encryptPlaceholder} aria-invalid="false" /></label></p>
        <button type="button" class="encrypt-button"><span>{locale.encryptButtonText}</span></button>
      </div>
    </div>
  </div>
  <Footer {lang} />
</div>
