---
const { cols, class: className = '', ...attrs } = Astro.props
const defaults = { sm: 1, md: 2, lg: 2 }
const numeric = Number(cols)
const columns = (typeof cols === 'string' || typeof cols === 'number') && Number.isInteger(numeric) && numeric > 0
  ? numeric
  : { ...defaults, ...(typeof cols === 'object' && cols ? cols : {}) }
const initial = typeof columns === 'number' ? columns : columns.sm
---

<div {...attrs} class:list={['vp-card-grid', `cols-${initial}`, className]} data-card-grid-cols={JSON.stringify(columns)} style={`grid-template-columns:repeat(${initial},1fr)`}>
  <slot />
</div>
