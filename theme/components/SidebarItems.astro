---
import SidebarItem from './SidebarItem.astro'
import type { ResolvedSidebarItem } from '../lib/sidebar'

const { items, currentId } = Astro.props as { items: ResolvedSidebarItem[], currentId: string }
---

{items.map(item => <div class="group no-transition"><SidebarItem {item} {currentId} depth={0} /></div>)}
