---
import { localeOf } from '../lib/locales'
const { enabled = true, lang = 'zh-CN' } = Astro.props as { enabled?: boolean, lang?: string }
const locale = localeOf(lang)
---

{enabled && (
  <button type="button" class="vp-back-to-top" aria-label={locale.returnToTopLabel} hidden>
    <span class="percent">0%</span>
    <span class="icon vpi-back-to-top" aria-hidden="true"></span>
    <svg aria-hidden="true" viewBox="0 0 48 48"><circle cx="50%" cy="50%"></circle></svg>
  </button>
)}
