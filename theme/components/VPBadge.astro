---
const { type = 'tip', text = '', color, bgColor, borderColor = 'transparent', class: className = '', ...attrs } = Astro.props
const style = color || bgColor ? `color:${color ?? ''};background-color:${bgColor ?? ''};border-color:${borderColor}` : undefined
---

<span {...attrs} class:list={['vp-badge', type, className]} {style}><slot>{text}</slot></span>

<style>
  .vp-badge { transition: var(--vp-t-color); transition-property: color, background-color, border-color; }
  :global(h1) .vp-badge, :global(h2) .vp-badge { margin: 0 0 0 2px; vertical-align: middle; }
  :global(h2) .vp-badge { padding: 0 8px; }
  :global(h3) .vp-badge { vertical-align: middle; }
  :global(h4) .vp-badge, :global(h5) .vp-badge, :global(h6) .vp-badge { line-height: 18px; vertical-align: middle; }
</style>
