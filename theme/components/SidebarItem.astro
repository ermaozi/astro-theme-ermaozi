---
import ThemeIcon from './ThemeIcon.astro'
import VPBadge from './VPBadge.astro'
import VPLink from './VPLink.astro'
import type { ResolvedSidebarItem } from '../lib/sidebar'

const { item, currentId, depth } = Astro.props as { item: ResolvedSidebarItem, currentId: string, depth: number }
const containsCurrent = (candidate: ResolvedSidebarItem): boolean => candidate.entryId === currentId || candidate.items?.some(containsCurrent) === true
const active = item.entryId === currentId
const hasActive = containsCurrent(item)
const hasChildren = Boolean(item.items?.length)
const collapsible = item.collapsed != null
const collapsed = Boolean(collapsible && item.collapsed && !hasActive)
const SectionTag = hasChildren ? 'section' : 'div'
const TextTag = (hasChildren && depth < 5 ? `h${depth + 2}` : 'p') as 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p'
const badge = typeof item.badge === 'string' ? { text: item.badge } : item.badge
---

<SectionTag class:list={['vp-sidebar-item', 'sidebar-item', `level-${depth}`, { collapsible, collapsed, 'is-link': item.link, 'is-active': active, 'has-active': hasActive }]}>
  {item.text && <div class="item" role={!item.link ? 'button' : undefined} tabindex={hasChildren ? 0 : undefined}>
    <div class="indicator"></div>
    {item.icon && <ThemeIcon icon={item.icon} class={item.separator ? 'separator' : ''} />}
    {item.link && !item.separator
      ? <VPLink href={item.link} rel={item.rel} target={item.target} aria-current={active ? 'page' : undefined}><TextTag class="text"><span set:html={item.text}></span>{badge && <VPBadge class="vp-menu-badge" {...badge} />}</TextTag></VPLink>
      : <TextTag class:list={['text', { separator: item.separator }]}><span set:html={item.text}></span>{badge && <VPBadge class="vp-menu-badge" {...badge} />}</TextTag>}
    {collapsible && <button class="caret" type="button" aria-label={`${collapsed ? 'Expand' : 'Collapse'} ${item.text}`} aria-expanded={!collapsed} tabindex="-1"><span class="vpi-chevron-right caret-icon"></span></button>}
  </div>}
  {hasChildren && depth < 5 && <div class="items-wrapper" hidden={collapsed}><div class="items">
    {item.items!.map(child => <Astro.self item={child} {currentId} depth={depth + 1} />)}
  </div></div>}
</SectionTag>
