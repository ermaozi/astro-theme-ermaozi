---
import type { EncryptedContent } from '../lib/encryption'
import type { Lang } from '../lib/content'
import { localeOf } from '../lib/locales'

const { payload, hint, lang } = Astro.props as { payload: EncryptedContent | EncryptedContent[], hint?: string, lang: Lang }
const locale = localeOf(lang)
const payloads = Array.isArray(payload) ? payload : [payload]
const first = payloads[0]
---

<div
  class="vp-page-encrypt"
  data-page-encrypt
  data-encrypt-ciphertext={first.ciphertext}
  data-encrypt-iv={first.iv}
  data-encrypt-salt={first.salt}
  data-encrypt-payloads={JSON.stringify(payloads)}
>
  <div class="logo"><span class="vpi-lock icon-lock-head" aria-hidden="true"></span></div>
  <div class="vp-encrypt-form">
    <p class="encrypt-text" set:html={hint || locale.encryptPageText}></p>
    <p class="encrypt-input-wrapper"><label for="encrypt-input"><span class="vpi-lock icon-lock" aria-hidden="true"></span><input id="encrypt-input" class="encrypt-input" type="password" autocomplete="off" placeholder={locale.encryptPlaceholder} aria-invalid="false" /></label></p>
    <button type="button" class="encrypt-button"><span>{locale.encryptButtonText}</span></button>
  </div>
</div>
<div class="decrypted-page-content" data-page-decrypted hidden></div>
