---
import VPLink from './VPLink.astro'

interface CategoryPost {
  type: 'post'
  title: string
  path: string
}

interface CategoryNode {
  type: 'category'
  title: string
  id: string
  sort: number
  items: CategoryTreeItem[]
}

type CategoryTreeItem = CategoryNode | CategoryPost

const { items, depth = 0, expandDepth = Infinity } = Astro.props as {
  items: CategoryTreeItem[]
  depth?: number
  expandDepth?: number
}
const nodeDepth = depth + 1
const expanded = nodeDepth <= expandDepth
---

<ul class:list={['vp-categories', { group: depth > 0 }]}>
  {items.map(item => (
    <li class="vp-categories-item">
      {item.type === 'post' ? (
        <p class="post"><span class="vpi-post" aria-hidden="true"></span><VPLink href={item.path} text={item.title} /></p>
      ) : (
        <div class:list={['vp-category-group', { expand: expanded }]} data-category-group data-category-id={item.id}>
          <p class="folder" role="button" tabindex="0" aria-expanded={expanded}><span class:list={['icon', expanded ? 'vpi-folder-open' : 'vpi-folder']} aria-hidden="true"></span><span>{item.title}</span></p>
          {item.items.length > 0 && <Astro.self items={item.items} depth={nodeDepth} {expandDepth} />}
        </div>
      )}
    </li>
  ))}
</ul>
