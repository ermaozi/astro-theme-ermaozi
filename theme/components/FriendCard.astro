---
import SocialLinks from './SocialLinks.astro'
import VPLink from './VPLink.astro'
import type { SocialLink } from '../lib/social'
import { withBase } from '../lib/client-utils'

type ThemeColor = string | { light: string, dark: string }
interface FriendItem {
  name: string
  link: string
  avatar?: string
  desc?: string
  location?: string
  organization?: string
  socials?: SocialLink[]
  backgroundColor?: ThemeColor
  color?: ThemeColor
  nameColor?: ThemeColor
}

const { friend } = Astro.props as { friend: FriendItem }
const color = (value?: ThemeColor) => typeof value === 'string' ? value : value ? `light-dark(${value.light}, ${value.dark})` : ''
const style = [
  friend.color && `--vp-friends-text-color:${color(friend.color)}`,
  friend.backgroundColor && `--vp-friends-bg-color:${color(friend.backgroundColor)}`,
  friend.nameColor && `--vp-friends-name-color:${color(friend.nameColor)}`,
].filter(Boolean).join(';')
const onlyTitle = !friend.desc && !friend.socials?.length && !friend.location && !friend.organization
---

<div class:list={['vp-friend', { 'only-title': onlyTitle, 'no-desc': !friend.desc }]} style={style || undefined}>
  <div class="avatar"><img src={withBase(friend.avatar, import.meta.env.BASE_URL)} alt={friend.name} /></div>
  <div class="content">
    <VPLink class="title" href={friend.link} text={friend.name} noIcon />
    {friend.location && <p class="location"><span class="vpi-location" aria-hidden="true"></span><span>{friend.location}</span></p>}
    {friend.organization && <p class="organization"><span class="vpi-organization" aria-hidden="true"></span><span>{friend.organization}</span></p>}
    {friend.desc && <p class:list={['desc', { offset: friend.location && friend.organization }]}>{friend.desc}</p>}
    {friend.socials?.length && <SocialLinks links={friend.socials} />}
  </div>
</div>

<style>
  .vp-friend {
    position: relative;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 20px;
    margin-bottom: 8px;
    background-color: var(--vp-friends-bg-color);
    border-radius: 6px;
    box-shadow: 0 0 0 transparent;
    transition: all var(--vp-t-color);
  }
  .vp-friend:hover { box-shadow: var(--vp-shadow-2); }
  .avatar { width: 88px; height: 88px; overflow: hidden; background-color: var(--vp-c-default-soft); border-radius: 100%; }
  .avatar img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .content { flex: 1 2; }
  .only-title .content { margin-top: 30px; }
  .content > :global(.title) { padding-bottom: 8px; font-size: 20px; font-weight: 700; color: var(--vp-friends-name-color); transition: color var(--vp-t-color), border-bottom var(--vp-t-color); }
  .content > :global(.title)::before { position: absolute; inset: 0; z-index: 1; content: ""; }
  .location, .organization { display: flex; gap: 8px; align-items: center; padding-top: 16px; margin: 0; font-size: 14px; color: var(--vp-friends-text-color); opacity: .8; transition: color var(--vp-t-color); }
  .location + .organization { padding-top: 0; }
  .desc { padding-top: 16px; margin: 0; line-height: 1.5; color: var(--vp-friends-text-color); transition: color var(--vp-t-color); }
  .desc.offset { margin-top: 4px; margin-left: -104px; }
  .content :global(.vp-social-links) { justify-content: flex-end; margin-top: 8px; }
  .content :global(.vp-social-link) { position: relative; z-index: 2; color: var(--vp-friends-name-color); }
  .no-desc .content :global(.vp-social-links) { justify-content: flex-start; }
</style>
