---
import type { Lang } from '../lib/content'
const { lang } = Astro.props as { lang: Lang }
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  class="vp-sign-down"
  role="button"
  tabindex="0"
  aria-label={lang.startsWith('zh') ? '滚动到下一区域' : 'Scroll to the next section'}
>
  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5">
    <path d="m19 11-7 6-7-6"></path>
    <path d="m19 5-7 6-7-6" opacity="0.6"></path>
  </g>
</svg>

<script>
  const control = document.querySelector<SVGSVGElement>('.vp-sign-down')
  if (control) {
    control.toggleAttribute('hidden', document.documentElement.scrollHeight <= innerHeight)
    const scrollDown = () => document.documentElement.scrollTo({
      top: innerHeight - (innerWidth >= 960 ? 64 : 0),
      behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
    })
    control.addEventListener('click', scrollDown)
    control.addEventListener('keydown', event => {
      if (event.key !== 'Enter' && event.key !== ' ') return
      event.preventDefault()
      scrollDown()
    })
  }
</script>
