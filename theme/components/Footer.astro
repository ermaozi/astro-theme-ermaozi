---
import type { Lang } from '../lib/content'
import { localeOf } from '../lib/locales'
import UserSlot from './UserSlot.astro'
import { hasUserSlot } from '../lib/user-slots'

type FooterConfig = { message?: string, copyright?: string }
const { lang, hasSidebar = false, enabled = true } = Astro.props as { lang: Lang, hasSidebar?: boolean, enabled?: boolean }
const locale = localeOf(lang)
const footer = locale.footer as false | FooterConfig
const userComponents = import.meta.glob<{ default: any }>('./footer/*.{astro,vue}', { eager: true })
const FooterContent = userComponents['./footer/FooterContent.astro']?.default ?? userComponents['./footer/FooterContent.vue']?.default
const hasFooterSlot = hasUserSlot('footer-content')
---

{enabled && footer && <>
  <footer class:list={['vp-footer', { 'has-sidebar': hasSidebar }]} vp-footer>
    {hasFooterSlot
      ? <UserSlot name="footer-content" {footer} {lang} />
      : FooterContent
      ? <FooterContent {footer} {lang} />
      : <div class="container">
          {footer.message && <div class="message" set:html={footer.message}></div>}
          {footer.copyright && <div class="copyright" set:html={footer.copyright}></div>}
        </div>}
  </footer>
  <script is:inline>
    (() => {
      const footer = document.currentScript?.previousElementSibling
      if (!(footer instanceof HTMLElement)) return
      const update = () => document.body.style.setProperty('--vp-footer-height', `${footer.offsetHeight}px`)
      update()
      new ResizeObserver(update).observe(footer)
    })()
  </script>
</>}
