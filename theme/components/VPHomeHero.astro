---
import VPButton from './VPButton.astro'
import TintPlate from './TintPlate.astro'
import HeroEffect from './vue/background/HeroEffect.vue'
import { isGradient, withBase } from '../lib/client-utils'

const props = Astro.props
const { hero = {}, full = false, onlyOnce = false, index, effectConfig, tintPlate } = props
const effects = new Set(['tint-plate', 'prism', 'pixel-blast', 'hyper-speed', 'liquid-ether', 'dot-grid', 'iridescence', 'orb', 'beams', 'lightning', 'dark-veil'])
const effect = props.effect || (effects.has(props.background) ? props.background : '')
const builtInEffect = effects.has(effect)
const heroEffectConfig = effect === 'tint-plate' || Object.prototype.toString.call(effectConfig) === '[object Object]' ? effectConfig : undefined
const effectClass = effect || 'null'
const background = props.backgroundImage
const legacyBackground = effects.has(props.background) ? '' : props.background
const image = String((typeof background === 'object' ? background.light : background) || legacyBackground || '').trim()
const darkImage = String((typeof background === 'object' ? background.dark ?? background.light : background) || legacyBackground || '').trim()
const hasBackground = Boolean(image || darkImage)
const cssUrl = (value = '') => `url('${String(value).replaceAll("'", '%27')}')`
const cssBackground = (value = '') => isGradient(String(value)) ? String(value) : cssUrl(withBase(value, import.meta.env.BASE_URL))
const bgStyle = hasBackground ? `${image ? `--vp-home-bg-light:${cssBackground(image)};--vp-home-bg-light-attachment:${props.backgroundAttachment || 'scroll'};` : ''}${darkImage ? `--vp-home-bg-dark:${cssBackground(darkImage)};--vp-home-bg-dark-attachment:${props.backgroundAttachment || 'scroll'};` : ''}--vp-hero-bg-filter:${props.filter || ''}` : undefined
---

<div class:list={['vp-home-hero', { full, once: onlyOnce, first: index === 0 }, effect]}>
  {effect === 'tint-plate'
    ? <TintPlate config={tintPlate ?? heroEffectConfig} />
    : builtInEffect
      ? <HeroEffect effect={effect} config={heroEffectConfig} client:visible />
      : hasBackground && <div class="home-hero-bg" data-home-background style={bgStyle}></div>}
  <div class="hero-container"><div class="hero-content">
    {hero.name && <h1 class="hero-name" set:html={hero.name}></h1>}
    {hero.tagline && <p class="hero-tagline" set:html={hero.tagline}></p>}
    {hero.text && <p class="hero-text" set:html={hero.text}></p>}
    {hero.actions?.length > 0 && <div class="actions"><div class="action">{hero.actions.map((action: any) => <VPButton tag="a" size="medium" theme={action.theme} text={action.text} href={action.link} target={action.target} rel={action.rel} icon={action.icon} suffixIcon={action.suffixIcon} />)}</div></div>}
  </div></div>
</div>

{props.forceDark && <script is:inline define:vars={{ effectClass }}>
  (() => {
    const root = document.documentElement
    root.classList.add('force-dark', 'dark', `effect-${effectClass}`)
    root.dataset.theme = 'dark'
    root.classList.add('no-transition')
    setTimeout(() => root.classList.remove('no-transition'), 300)
  })()
</script>}
