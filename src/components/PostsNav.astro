---
import type { Lang } from '../lib/content'
import { localeOf } from '../lib/locales'
import { postCollectionsFor, type ResolvedPostCollection } from '../lib/collections'
import VPLink from './VPLink.astro'
import { withoutBase } from '../lib/client-utils'

const { lang, blogStats, local = false, collection = postCollectionsFor(lang)[0] } = Astro.props as {
  lang: Lang
  blogStats: { tags: number; categories: number; posts: number }
  local?: boolean
  collection?: ResolvedPostCollection
}
const locale = localeOf(lang)
const currentPath = withoutBase(Astro.url.pathname, import.meta.env.BASE_URL)
const items = [
  { enabled: collection?.tags !== false, href: collection?.tagsLink, text: collection?.tagsText ?? locale.tagText, total: blogStats.tags, icon: 'vpi-tag' },
  { enabled: collection?.categories !== false, href: collection?.categoriesLink, text: collection?.categoriesText ?? locale.categoryText, total: blogStats.categories, icon: 'vpi-category' },
  { enabled: collection?.archives !== false, href: collection?.archivesLink, text: collection?.archivesText ?? locale.archiveText, total: blogStats.posts, icon: 'vpi-archive' },
].filter(item => item.enabled && item.href)
---

<div class:list={['vp-posts-nav', { local }]}>
  {items.map(item => {
    const href = item.href!
    return <VPLink class:list={['nav-link', { active: currentPath === href }]} {href}>
      <span class:list={['icon icon-logo', item.icon]} aria-hidden="true"></span>
      <span class="text">{item.text}</span>
      <span class="total">{item.total}</span>
      <span class="icon vpi-chevron-right" aria-hidden="true"></span>
    </VPLink>
  })}
</div>
