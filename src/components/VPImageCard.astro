---
import { numToUnit, withBase, withoutBase } from '../lib/client-utils'
import { languageFromPath } from '../lib/locales'

const { image, title = '', description = '', href, author = '', date, width, center = false, class: className = '', ...attrs } = Astro.props
const lang = languageFromPath(withoutBase(Astro.url.pathname, import.meta.env.BASE_URL))
const instance = date instanceof Date ? date : date ? new Date(date) : undefined
const dateText = instance && !Number.isNaN(instance.getTime())
  ? new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'short', day: 'numeric' }).format(instance)
  : ''
const imageUrl = withBase(image, import.meta.env.BASE_URL)
---

<div {...attrs} class:list={['vp-image-card', className, { center }]} style={width ? `width:${numToUnit(width)}` : undefined}>
  <div class="image-container">
    <img src={imageUrl} alt={title} loading="lazy" />
    {(title || author || dateText || description) && <div class="image-info">
      {title && <h3 class="title">
        {href ? <a {href} target="_blank" rel="noopener noreferrer" class="no-icon">{title}</a> : <span>{title}</span>}
      </h3>}
      {(author || dateText) && <p class="copyright">
        {author && <span>{author}</span>}
        {author && dateText && <span> | </span>}
        {dateText && <span>{dateText}</span>}
      </p>}
      {description && <p class="description">{description}</p>}
    </div>}
  </div>
</div>
