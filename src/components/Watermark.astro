---
import type { WatermarkOptions } from 'watermark-js-plus'

type Options = Omit<Partial<WatermarkOptions>, 'content'> & {
  content?: string | string[]
  fullPage?: boolean
  opacity?: number
}

const { options, title } = Astro.props as { options?: Options, title: string }
const { fullPage = true, opacity, ...configured } = options ?? {}
const content = Array.isArray(configured.content) ? configured.content.join(' · ') : configured.content
const watermarkOptions = options
  ? {
      fontColor: '#76747f',
      globalAlpha: configured.mode === 'blind' ? 0.005 : (configured.globalAlpha ?? opacity ?? 0.165),
      ...configured,
      content: content || title,
      parent: fullPage ? 'body' : '.vp-doc',
    }
  : undefined
---

{watermarkOptions && <script
  is:inline
  type="application/json"
  data-watermark-options
  set:html={JSON.stringify(watermarkOptions).replaceAll('<', '\\u003c')}
></script>}
