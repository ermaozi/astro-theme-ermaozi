---
import { withBase, resolveNavLink } from '../lib/client-utils'
import { languageFromPath, localeOf } from '../lib/locales'

const { tag, href, text = '', noIcon = false, target, rel, class: className = '', ...attrs } = Astro.props
const external = target === '_blank' || (typeof href === 'string' && /^(?:[a-z]+:|\/\/)/iu.test(href))
const Tag = tag ?? (href ? 'a' : 'span')
const openNewWindowText = localeOf(languageFromPath(Astro.url.pathname)).openNewWindowText
const resolvedHref = href && !external ? withBase(href, import.meta.env.BASE_URL) : href
const resolvedText = text || external || !href ? text : resolveNavLink(href).text
---

<Tag {...attrs} class:list={['vp-link', { link: href, 'no-icon': noIcon, 'vp-external-link-icon': external }, className]} href={resolvedHref} target={target ?? (external ? '_blank' : undefined)} rel={rel ?? (external ? 'noopener noreferrer' : undefined)}>
  <slot>{resolvedText || href}</slot><slot name="after-text" />
  {external && !noIcon && <span class="visually-hidden">{openNewWindowText}</span>}
</Tag>

<style>
  .vp-link:focus-visible { border-radius: 2px; }
</style>
