---
import type { OutlineItem } from '../lib/outline'

const { items, root = false } = Astro.props as { items: OutlineItem[], root?: boolean }
---

<ul class={root ? 'root' : 'nested'}>
  {items.map(item => <li>
    <a class="outline-link" href={`#${item.id}`}>{item.label}</a>
    {item.children.length > 0 && <Astro.self items={item.children} />}
  </li>)}
</ul>
