---
import type { GitContributor } from '../lib/git'
import type { Lang } from '../lib/content'
import { localeOf } from '../lib/locales'

const { lang, contributors } = Astro.props as {
  lang: Lang
  contributors: GitContributor[]
}
const locale = localeOf(lang)
---

{contributors.length > 0 && <>
  <h2 id="doc-contributors" tabindex="-1"><a href="#doc-contributors" class="header-anchor"><span>{locale.contributorsText}</span></a></h2>
  <div class="vp-contributors">
    {contributors.map(contributor => contributor.url ? (
      <a href={contributor.url} target="_blank" rel="noreferrer" class="vp-contributor">
        {contributor.avatar && <img src={contributor.avatar} alt="" class="vp-contributor-avatar" loading="lazy" />}
        <span class="vp-contributor-name">{contributor.name}</span>
      </a>
    ) : (
      <span class="vp-contributor">
        {contributor.avatar && <img src={contributor.avatar} alt="" class="vp-contributor-avatar" loading="lazy" />}
        <span class="vp-contributor-name">{contributor.name}</span>
      </span>
    ))}
  </div>
</>}
