---
import ThemeIcon from './ThemeIcon.astro'
import VPLink from './VPLink.astro'

const { href, title = '', icon, description = '', target, rel, class: className = '', ...attrs } = Astro.props
---

<div {...attrs} class:list={['vp-link-card', className]}>
  <span class="body">
    <VPLink {href} {target} {rel} noIcon class="link no-icon">
      <slot name="title">
        {icon && <ThemeIcon name={icon} />}
        {title && <span class="text" set:html={title}></span>}
      </slot>
    </VPLink>
    <slot>{description && <p set:html={description}></p>}</slot>
  </span>
  <span class="vpi-arrow-right" aria-hidden="true"></span>
</div>
