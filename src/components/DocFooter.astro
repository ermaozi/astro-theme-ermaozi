---
import type { Lang } from '../lib/content'
import { localeOf } from '../lib/locales'
import ThemeIcon from './ThemeIcon.astro'
import VPLink from './VPLink.astro'
type Link = { href: string, title: string, icon?: string | { svg: string } }
type Contributor = { name: string }

const {
  lang,
  previous,
  next,
  editUrl = '',
  updated,
  formatOptions,
  contributors = [],
} = Astro.props as {
  lang: Lang
  previous?: Link
  next?: Link
  editUrl?: string
  updated?: Date
  formatOptions?: Intl.DateTimeFormatOptions & { forceLocale?: boolean }
  contributors?: Contributor[]
}
const locale = localeOf(lang)
const { forceLocale = false, ...configuredDateOptions } = formatOptions ?? {}
const dateOptions = Object.keys(configuredDateOptions).length ? configuredDateOptions : { dateStyle: 'short', timeStyle: 'short' } as const
const updatedLabel = updated && new Intl.DateTimeFormat(forceLocale ? lang : undefined, dateOptions).format(updated)
---

<footer class="vp-doc-footer">
  <slot />
  {(editUrl || updatedLabel) && <div class="edit-info">
    {editUrl && <div class="edit-link"><VPLink class="edit-link-button" href={editUrl} noIcon><span class="vpi-square-pen edit-link-icon" aria-label="edit icon"></span>{locale.editLinkText}</VPLink></div>}
    {updatedLabel && <div class="last-updated" aria-label="Last updated"><p class="last-updated-text">{locale.lastUpdatedText}: <time datetime={updated!.toISOString()} class="last-updated-time" data-date-options={forceLocale ? undefined : JSON.stringify(dateOptions)}>{updatedLabel}</time></p></div>}
  </div>}
  {contributors.length > 0 && <div class:list={['contributors', { right: Boolean(updatedLabel) }]} aria-label="Contributors">
    <span class="contributors-label">{locale.contributorsText}:</span>
    <span class="contributors-info">{contributors.map((contributor, index) => <><span class="contributor">{contributor.name}</span>{index < contributors.length - 1 && ', '}</>)}</span>
  </div>}
  {(previous || next) && <nav class="prev-next">
    <div class="pager">{previous && <VPLink class="pager-link prev" href={previous.href}><span class="desc" set:html={locale.prevPageLabel}></span><span class="title">{previous.icon && <ThemeIcon icon={previous.icon} />}<span set:html={previous.title}></span></span></VPLink>}</div>
    <div class="pager">{next && <VPLink class="pager-link next" href={next.href}><span class="desc" set:html={locale.nextPageLabel}></span><span class="title">{next.icon && <ThemeIcon icon={next.icon} />}<span set:html={next.title}></span></span></VPLink>}</div>
  </nav>}
</footer>

{updatedLabel && !forceLocale && <script>
  document.querySelectorAll<HTMLTimeElement>('.last-updated-time[data-date-options]').forEach(time => {
    const date = new Date(time.dateTime)
    if (!Number.isNaN(date.getTime())) time.textContent = new Intl.DateTimeFormat(undefined, JSON.parse(time.dataset.dateOptions || '{}')).format(date)
  })
</script>}
