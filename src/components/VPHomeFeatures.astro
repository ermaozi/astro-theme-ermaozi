---
import VPHomeBox from './VPHomeBox.astro'
import ThemeIcon from './ThemeIcon.astro'
import VPImage from './VPImage.astro'
import VPLink from './VPLink.astro'

const { features, title, description, ...boxProps } = Astro.props
const length = features?.length ?? 0
const grid = length === 2 ? 'grid-2' : length === 3 ? 'grid-3' : length % 3 === 0 ? 'grid-6' : length > 3 ? 'grid-4' : undefined
---

{features && <VPHomeBox class="vp-home-features" {...boxProps}>
  {title && <h2 class="title" set:html={title}></h2>}
  {description && <p class="description" set:html={description}></p>}
  <div class="items">{features.map((feature: any) => {
    return <div class:list={[grid, 'item']}><VPLink tag={feature.link ? 'a' : 'div'} class="vp-home-feature" href={feature.link} target={feature.target} rel={feature.rel} noIcon><article class="box">
      {typeof feature.icon === 'object' && feature.icon?.wrap
        ? <div class="icon"><VPImage image={feature.icon} alt={feature.icon.alt} height={feature.icon.height || 48} width={feature.icon.width || 48} /></div>
        : typeof feature.icon === 'object'
          ? <VPImage image={feature.icon} alt={feature.icon.alt} height={feature.icon.height || 48} width={feature.icon.width || 48} />
          : typeof feature.icon === 'string' && /^[\w-]+:[\w-]+$/u.test(feature.icon)
            ? <div class="icon"><ThemeIcon name={feature.icon} /></div>
            : feature.icon && <div class="icon" set:html={feature.icon}></div>}
      <h2 class="title" set:html={feature.title}></h2>
      {Array.isArray(feature.details) ? <ul class="details">{feature.details.map((detail: string) => <li set:html={detail}></li>)}</ul> : feature.details && <p class="details" set:html={feature.details}></p>}
      {feature.linkText && <div class="link-text"><p class="link-text-value">{feature.linkText}<span class="vpi-arrow-right link-text-icon"></span></p></div>}
    </article></VPLink></div>
  })}</div>
</VPHomeBox>}
