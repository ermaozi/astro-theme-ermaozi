---
import type { Lang } from '../lib/content'
import type { OutlineItem } from '../lib/outline'
import { localeOf } from '../lib/locales'
import OutlineItems from './OutlineItems.astro'

const { lang, toc, hasSidebar = false, isPosts = false, locked = false } = Astro.props as { lang: Lang, toc: OutlineItem[], hasSidebar?: boolean, isPosts?: boolean, locked?: boolean }
const locale = localeOf(lang)
const en = !lang.startsWith('zh')
---

<div class:list={['vp-local-nav', { 'has-sidebar': hasSidebar, 'is-posts': isPosts, 'with-outline': locked }]}>
  <button class:list={['menu', { hidden: isPosts }]} type="button" disabled={isPosts} aria-expanded="false" aria-controls="SidebarNav">
    <span class="vpi-align-left menu-icon" aria-hidden="true"></span><span class="menu-text">{locale.sidebarMenuLabel ?? (en ? 'Menu' : '菜单')}</span>
  </button>
  {!locked && <div class="vp-local-nav-outline-dropdown">
    {toc.length > 0 && <Fragment>
      <button class="outline-toggle" type="button" aria-expanded="false">{locale.outlineLabel}<span class="vpi-chevron-right icon" aria-hidden="true"></span></button>
      <div class="outline-mask" hidden></div>
      <div class="items" hidden><div class="outline"><OutlineItems items={toc} /></div></div>
    </Fragment>}
  </div>}
</div>
