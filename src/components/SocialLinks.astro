---
import type { SocialLink } from '../lib/social'
import { socialIconName, socialLabel, socialSvg } from '../lib/social'

const { links, class: className } = Astro.props as { links: SocialLink[], class?: string }
---

<div class:list={['vp-social-links', className]}>
  {links.map(link => {
    const svg = socialSvg(link.icon)
    return <a class="vp-social-link no-icon" href={link.link} aria-label={socialLabel(link)} title={socialLabel(link)} target="_blank" rel="noopener">
      <span class="vp-icon is-svg" data-iconify-remote={!svg ? socialIconName(link.icon) : undefined} set:html={svg}></span>
    </a>
  })}
</div>
