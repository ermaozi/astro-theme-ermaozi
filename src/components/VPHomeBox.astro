---
import { withBase } from '../lib/client-utils'

const { backgroundAttachment = '', backgroundImage, containerClass = '', full = false, type: _type, index: _index, onlyOnce: _onlyOnce, class: className = '', ...attrs } = Astro.props
const image = typeof backgroundImage === 'string' ? backgroundImage : backgroundImage?.light ?? ''
const darkImage = typeof backgroundImage === 'object' ? backgroundImage?.dark ?? image : image
const hasBackground = Boolean(image || darkImage)
const lightUrl = withBase(image, import.meta.env.BASE_URL)
const darkUrl = withBase(darkImage, import.meta.env.BASE_URL)
const style = hasBackground
  ? `${image ? `--vp-home-bg-light:url('${String(lightUrl).replaceAll("'", '%27')}');--vp-home-bg-light-attachment:${backgroundAttachment || 'scroll'};` : ''}${darkImage ? `--vp-home-bg-dark:url('${String(darkUrl).replaceAll("'", '%27')}');--vp-home-bg-dark-attachment:${backgroundAttachment || 'scroll'};` : ''}`
  : undefined
---

<div {...attrs} class:list={['vp-home-box', className, { full }]} data-home-background={hasBackground ? '' : undefined} style={style}>
  <slot name="before" />
  <div class:list={['container', containerClass]}><slot /></div>
  <slot name="after" />
</div>
