---
import VPButton from './VPButton.astro'
import { withBase } from '../lib/client-utils'

const { banner = 'https://api.pengzhanbo.cn/wallpaper/bing', bannerMask = 0, hero = {} } = Astro.props
const lightMask = (typeof bannerMask === 'object' ? bannerMask.light : bannerMask) || 0
const darkMask = (typeof bannerMask === 'object' ? bannerMask.dark : bannerMask) || 0
const bannerUrl = withBase(banner, import.meta.env.BASE_URL)
---

<div class="vp-home-banner" style={`background-image:url(${String(bannerUrl).replaceAll(')', '%29')});--vp-banner-mask-light:${lightMask};--vp-banner-mask-dark:${darkMask}`}>
  <div class="banner-mask"></div>
  <div class="container"><div class="content">
    {(hero.name ?? 'Plume') && <h2 class="hero-name">{hero.name ?? 'Plume'}</h2>}
    {(hero.tagline ?? 'A VuePress Theme') && <p class="hero-tagline"><span class="line"></span><span>{hero.tagline ?? 'A VuePress Theme'}</span></p>}
    {hero.text && <p class="hero-text">{hero.text}</p>}
    {hero.actions?.length > 0 && <div class="actions">{hero.actions.map((action: any) => <div class="action"><VPButton tag="a" size="medium" theme={action.theme} text={action.text} href={action.link} /></div>)}</div>}
  </div></div>
</div>
