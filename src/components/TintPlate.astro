---
const { config = null } = Astro.props
---

<div class="bg-filter" data-tint-plate data-config={JSON.stringify(config)}>
  <canvas width="32" height="32"></canvas>
</div>

<script>
  import { tintPlateColors } from '../lib/tint-plate'

  document.querySelectorAll<HTMLElement>('[data-tint-plate]').forEach(root => {
    const canvas = root.querySelector('canvas')!
    const context = canvas.getContext('2d')!
    const config = JSON.parse(root.dataset.config || 'null')
    let colors = tintPlateColors(config, document.documentElement.dataset.theme === 'dark')
    let time = 0
    const observer = new MutationObserver(() => { colors = tintPlateColors(config, document.documentElement.dataset.theme === 'dark') })
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
    const draw = () => {
      for (let x = 0; x <= 35; x++) for (let y = 0; y <= 35; y++) {
        const r = Math.floor(colors.r.value + colors.r.offset * Math.cos((x * x - y * y) / 300 + time))
        const g = Math.floor(colors.g.value + colors.g.offset * Math.sin((x * x * Math.cos(time / 4) + y * y * Math.sin(time / 3)) / 300))
        const b = Math.floor(colors.b.value + colors.b.offset * Math.sin(5 * Math.sin(time / 9) + ((x - 100) ** 2 + (y - 100) ** 2) / 1100))
        context.fillStyle = `rgb(${r},${g},${b})`
        context.fillRect(x, y, 1, 1)
      }
      time += 0.020
      requestAnimationFrame(draw)
    }
    draw()
  })
</script>

<style>
  .bg-filter { position: absolute; inset: 0; overflow: hidden; pointer-events: none; transform: translate3d(0, 0, 0); }
  :global(.vp-home-hero.full.once) .bg-filter { height: calc(100% + var(--vp-footer-height, 0px)); }
  @property --vp-home-hero-bg-filter { inherits: false; initial-value: #fff; syntax: "<color>"; }
  .bg-filter::after { --vp-home-hero-bg-filter: var(--vp-c-bg); position: absolute; inset: 0; content: ""; background: linear-gradient(to bottom, var(--vp-home-hero-bg-filter) 0, transparent 45%, transparent 55%, var(--vp-home-hero-bg-filter) 140%); transition: --vp-home-hero-bg-filter var(--vp-t-color); }
  canvas { width: 100%; height: 100%; }
</style>
