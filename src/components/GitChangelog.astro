---
import type { GitChangelogItem } from '../lib/git'
import type { Lang } from '../lib/content'
import { localeOf } from '../lib/locales'

const { lang, items } = Astro.props as {
  lang: Lang
  items: GitChangelogItem[]
}
const locale = localeOf(lang)
const date = new Intl.DateTimeFormat(lang, { dateStyle: 'short' })
const updated = new Intl.DateTimeFormat(lang, { dateStyle: 'short', timeStyle: 'short' })
---

{items.length > 0 && <>
  <h2 id="doc-changelog" tabindex="-1"><a href="#doc-changelog" class="header-anchor"><span>{locale.changelogText}</span></a></h2>
  <div class="vp-changelog-wrapper" data-git-changelog>
    <button class="vp-changelog-header" type="button" aria-expanded="false" aria-controls="doc-changelog-list">
      <span class="vp-latest-updated"><span class="vp-changelog-icon"></span><span>{updated.format(items[0].time)}</span></span>
      <span><span class="vp-changelog-menu-icon"></span><span>{locale.changelogButtonText}</span></span>
    </button>
    <ul id="doc-changelog-list" class="vp-changelog-list">
      {items.map(item => item.tag ? (
        <li class="vp-changelog-item-tag">
          <div>
            {item.tagUrl ? <a class="vp-changelog-tag" href={item.tagUrl} target="_blank" rel="noreferrer"><code>{item.tag}</code></a> : <span class="vp-changelog-tag"><code>{item.tag}</code></span>}
            <span class="vp-changelog-date">{locale.changelogOnText} <time datetime={new Date(item.time).toISOString()}>{date.format(item.time)}</time></span>
          </div>
        </li>
      ) : (
        <li class="vp-changelog-item-commit">
          {item.commitUrl ? <a class="vp-changelog-hash" href={item.commitUrl} target="_blank" rel="noreferrer"><code>{item.hash.slice(0, 5)}</code></a> : <span class="vp-changelog-hash"><code>{item.hash.slice(0, 5)}</code></span>}
          <span class="vp-changelog-divider">-</span>
          <span class="vp-changelog-message" set:html={item.message}></span>
          <span class="vp-changelog-date">{locale.changelogOnText} <time datetime={new Date(item.time).toISOString()}>{date.format(item.time)}</time></span>
        </li>
      ))}
    </ul>
  </div>
</>}

<script>
  document.querySelectorAll<HTMLElement>('[data-git-changelog]').forEach(wrapper => {
    const button = wrapper.querySelector<HTMLButtonElement>('.vp-changelog-header')
    if (!button || button.dataset.ready) return
    button.dataset.ready = 'true'
    button.addEventListener('click', () => {
      const expanded = wrapper.classList.toggle('active')
      button.setAttribute('aria-expanded', String(expanded))
    })
  })
</script>
